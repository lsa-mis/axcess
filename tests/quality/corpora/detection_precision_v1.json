{
  "schema_version": 1,
  "corpus_id": "axcess-detection-precision",
  "corpus_version": "1.0.2",
  "label_method": "synthetic_by_construction",
  "scope_statement": "Frozen Axcess outputs for adversarial synthetic accessibility scenarios with binary labels known from fixture construction.",
  "limitations": [
    "This synthetic regression corpus is not representative of all U-M sites, frameworks, assistive technologies, languages, or authenticated applications.",
    "The percentages are point estimates for these named samples; they are not confidence bounds or proof of real-world conformance accuracy.",
    "Model-backed outputs are frozen snapshots. Model, prompt, OCR, or inference-runtime changes require an explicit corpus-version update and fresh review.",
    "A production accuracy claim requires a separately governed, expert-labeled and representative U-M validation corpus that is not included here."
  ],
  "producers": {
    "axe": "axe-core 4.10.2 bundled runner",
    "alfa": "Siteimprove Alfa pinned local runner",
    "behavioral": "Axcess keyboard, responsive, focus, and deterministic motion probes",
    "ocr_vlm": "Axcess Tesseract plus local image/visual-model review leads",
    "semantic": "Axcess local semantic-model review leads"
  },
  "gate": {
    "max_false_discovery_rate_exclusive": 0.05,
    "min_surfaced_per_layer": 20,
    "min_negative_controls_per_layer": 5,
    "min_recall": 0.8
  },
