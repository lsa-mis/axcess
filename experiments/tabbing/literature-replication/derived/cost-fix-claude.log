['02-InitialCrawlKnfg','03-CrawlKnfg','05-CrawlInputsKnfg'],'InitializeProxyPcnfg':['06-InitializeProxyPcnfg'],'ExtractNodesPcnfg':['07-ExtractNodesPcnfg','11-ExtractNodesInCrawlPcnfg'],'CrawlPcnfg':['08-BuildEFEsPcnfg','09-InitialCrawlPcnfg','10-CrawlPcnfg'],'Detection (vs Type1)':['01-Type1Detection'],'Detection (vs Type1+Type2)':['01-Type1Detection','02-Type2Detection']}\nprint('%-28s %7s %7s %7s | %4s %4s %4s | sumratio | outliers(>25%%)' % ('col','p25','med','p75','<=2%','<=5%','<=10%'))\nfor c,ks in M.items():\n    cc = c.split(' ')[0]\n    rat = {s: sum(ph[s][k] for k in ks)/float(rows[s][cc]) for s in subs}\n    v = sorted(rat.values()); q = st.quantiles(v, n=4)\n    w = lambda t: sum(1 for x in v if abs(x-1)<=t)\n    out = sorted(((s,round(r,2)) for s,r in rat.items() if abs(r-1)>0.25), key=lambda t:-abs(t[1]-1))\n    tot = sum(sum(ph[s][k] for k in ks) for s in subs)/sum(float(rows[s][cc]) for s in subs)\n    print('%-28s %7.3f %7.3f %7.3f | %4d %4d %4d | %.3f | %d %s' % (c,q[0],st.median(v),q[2],w(.02),w(.05),w(.10),tot,len(out),out[:12]))\n# TotalConstruct\nd12=[ph[s]['12-TotalConstructKnfg']-ph[s]['05-CrawlInputsKnfg'] for s in subs]\nd13=[ph[s]['13-TotalConstructPcnfg']-ph[s]['10-CrawlPcnfg'] for s in subs]\nd12b=[ph[s]['12-TotalConstructKnfg']-(ph[s]['03-CrawlKnfg']+ph[s]['05-CrawlInputsKnfg']) for s in subs]\nprint('12-05 min/med/max', min(d12), st.median(d12), max(d12))\nprint('12-(03+05) min/med/max', min(d12b), st.median(d12b), max(d12b))\nprint('13-10 min/med/max', min(d13), st.median(d13), max(d13))\nprint('08 values', sorted(set(ph[s]['08-BuildEFEsPcnfg'] for s in subs)))\n\"\n","description":"Per-phase agreement bands and TotalConstruct relation"}},{"tool_name":"Bash","tool_use_id":"toolu_01GHk8q4taD6mgsumDKWDKJi","tool_input":{"command":"uv run --offline --no-sync python -B -m tools.kafe_matrix assemble > /dev/null; echo \"exit=$?\"","timeout":300000,"description":"Rerun assemble after prose fix"}},{"tool_name":"Bash","tool_use_id":"toolu_01BiisF722GZ2RfPBJ8B6XKM","tool_input":{"command":"uv run --offline --no-sync python -B -c \"\nimport json\nsumm = json.load(open('derived/kafe_matrix_summary.json'))['rows']\nlines = open('FINAL-REPORT.md').read().splitlines()\nstart = lines.index('### 5.1 KAFE corpus — Chiou, Alotaibi & Halfond, ESEC/FSE 2021, DOI 10.1145/3468264.3468581')\nhdr = next(i for i in range(start, len(lines)) if lines[i].startswith('| detector |'))\ni = hdr + 2\nout = []\nwhile lines[i].startswith('|'):\n    cells = [c.strip() for c in lines[i].replace(r'\\|', '\\x00').strip('|').split('|')]\n    cells = [c.replace('\\x00', r'\\|') for c in cells]\n    name = cells[0].replace(r'\\|', '|')\n    key = next((k for k in summ if k == name), None)\n    if key is None and name.startswith('**KAFE'):\n        key = 'KAFE (Chiou et al., ESEC/FSE 2021)'\n    r = summ[key]\n    pct = lambda v: '%.1f%%' % (100 * v)\n    if key.startswith('KAFE'):\n        cells[4] = cells[5] = '0 (decided all 39)'\n        cells[7] = '%s · decided %s (all 39 decided)' % (pct(r['recall_strict']), pct(r['recall']))\n    else:\n        cells[4], cells[5] = str(r['unknown_positive']), str(r['unknown_negative'])\n        cells[7] = '%s · decided %s' % (pct(r['recall_strict']), pct(r['recall']))\n    out.append('| ' + ' | '.join(cells) + ' |')\n    i += 1\nprint(hdr + 3, i)\nprint('\\n'.join(out))\n\" > /tmp/claude-51rows.txt; head -3 /tmp/claude-51rows.txt; tail -2 /tmp/claude-51rows.txt","description":"Generate replacement §5.1 rows from summary"}},{"tool_name":"Bash","tool_use_id":"toolu_01K3gUntMYSP6M5GoMtxtWmg","tool_input":{"command":"uv run --offline --no-sync python -B -c \"\nimport subprocess\ndef tables(text):\n    out, cur = [], []\n    for l in text.splitlines() + ['']:\n        s = l.strip()\n        if s.startswith('|'): cur.append(s)\n        elif cur: out.append(cur); cur = []\n    res = []\n    for t in out:\n        if len(t) < 3: continue\n        split = lambda l: [c.strip() for c in l.replace(r'\\|', '\\x00').strip('|').split('|')]\n        head = split(t[0]); body = [split(l) for l in t[2:]]\n        res.append((head, body))\n    return res\nren = {'recall': ('recall (decided)', 'strict recall'), 'F1': ('F1 (decided recall)',)}\nfor f in ('FINAL-REPORT.md', 'KAFE-HIGHLIGHTS.md', 'KAFE-MATRIX.md'):\n    old = tables(subprocess.run(['git','show','HEAD:experiments/tabbing/literature-replication/'+f],capture_output=True,text=True,check=True).stdout)\n    new = tables(open(f).read())\n    print('==', f, 'tables old', len(old), 'new', len(new))\n    oi = 0\n    for nh, nb in new:\n        # match old table by first column header and row keys\n        match = next(((j, oh, ob) for j, (oh, ob) in enumerate(old) if oh[0] == nh[0] and [r[0] for r in ob] == [r[0] for r in nb]), None)\n        if match is None:\n            print('  NEW TABLE (no old counterpart):', nh[:4], len(nb), 'rows'); continue\n        j, oh, ob = match\n        changed = []\n        for orow, nrow in zip(ob, nb):\n            od, nd = dict(zip(oh, orow)), dict(zip(nh, nrow))\n            for c in oh:\n                cand = [c] + list(ren.get(c, ()))\n                nc = next((x for x in cand if x in nd), None)\n                if nc is None: changed.append((orow[0], c, od[c], '<column removed>')); continue\n                if od[c] != nd[nc]: changed.append((orow[0][:40], c, od[c][:50], nd[nc][:60]))\n        added = [c for c in nh if c not in oh and c not in sum(ren.values(), ())]\n        print('  table', nh[:3], '...: added cols', added, '| changed cells in old columns:', len(changed))\n        from collections import Counter\n        cc = Counter(c for _, c, _, _ in changed)\n        if cc: print('     by column:', dict(cc))\n        for x in changed:\n            if x[1] not in ('unknown pos', 'unknown neg', 'strict recall'): print('     ', x)\n\"","description":"Compare every table cell against HEAD in three reports"}},{"tool_name":"Bash","tool_use_id":"toolu_01EZHDZraVhrgaRg4SJnb2sx","tool_input":{"command":"git status --short --untracked-files=all ../../.. && git diff --stat ../../../src && wc -l derived/kafe_matrix.jsonl && git diff --quiet derived/kafe_matrix.jsonl && echo jsonl-unchanged","description":"Final status, src/audit and JSONL checks"}},{"tool_name":"Bash","tool_use_id":"toolu_019xGpxntQgkukHM1bCpYnDf","tool_input":{"command":"cd /var/home/me/Development/axcess/experiments && git status --short --untracked-files=all","description":"Show working tree status for experiments"}},{"tool_name":"Bash","tool_use_id":"toolu_01H3pFaAjPDps6TqdFZj3iUt","tool_input":{"command":"cd /var/home/me/Development/axcess/experiments && git diff --name-only HEAD -- :/src/audit","description":"Check for changes under src/audit"}},{"tool_name":"Bash","tool_use_id":"toolu_01XWg9ZAYEPQ8UbqZ3ePxBiu","tool_input":{"command":"git -C /var/home/me/Development/axcess/experiments/tabbing/literature-replication status --short --untracked-files=all -- :/","description":"Show repo-wide working tree status"}},{"tool_name":"Bash","tool_use_id":"toolu_01RuAgb1EnrohjY2iFN2cYe4","tool_input":{"command":"git -C /var/home/me/Development/axcess/experiments/tabbing/literature-replication status --short --untracked-files=all","description":"Show working tree status"}}],"terminal_reason":"completed","fast_mode_state":"off","fast_mode_disabled_reason":"sdk_opt_in_required","subagent_stats":{"spawned":0,"requested":{"background":0,"foreground":0,"unset":0},"started_in_background":0,"max_depth":0,"spawned_by_subagents":0,"completed":0,"failed":0,"killed":{"parent":0,"user":0,"system":0},"refused":{"depth_limit":0,"concurrency_limit":0,"budget":0},"by_type":{}},"is_error":false,"num_turns":155,"subtype":"success","api_error_status":null,"result":"I've finished the brief, including both new sections from the 21:30 update, and nothing is committed. The progress file runs from [4] to [12]. `src/audit/` is untouched, `derived/kafe_matrix.jsonl` is still 52 lines, and no downloaded file appears in `git status`.\n\n## KAFE's timing files\n- **Download:** `tools/fetch_kafe_output.py` (new) fetched the 3 named files for each of the 60 subjects: 180 files, 34.6 KB, no failures. They're under `artifacts/kafe_output/`, which the existing `artifacts/` rule already ignores, so no new rule was needed. Six loose CSVs in the Drive folder's root weren't fetched, as instructed.\n- **Gaps:** none. No file is missing, empty or unparseable.\n- **Denominator check:** `Size of All Visible Ctrl Nodes` matches the results CSV on 59 of 60 subjects. **resellerratings is 50 in its own file and 146 in the CSV.** I kept the CSV figure. Using 50 would change the scored-39 pooled figures to 90.0 (Type 1) and 24,260.9 (full pipeline), and no under-300 count.\n- **Phase mapping:** I tested every combination of up to four phases, and the best fit for each column matches the phase names: 00; 01+04; 02+03+05; 06; 07+11; 08+09+10. Phases 12 and 13 overlap other phases and aren't summed. Pooled, the six mapped columns agree with the CSV to within 3.5%. Subject by subject they don't all agree:\n  - The two proxy-start-up columns match only loosely.\n  - A few subjects are off by up to 6× (worst: indiegogo `CrawlKnfg` 5.96×).\n  - Five subjects' node counts differ as well.\n\n  So the logs look like a separate run of the same pipeline, not the same record. **`Detection` matches no phase**: it differs from the logged Type 1 time by more than 5% on 59 of 60 subjects. The per-phase table is in `FINAL-REPORT.md` §8.4.\n\n## New cost figures (ms per visible control, pooled)\n\n| scope | scored 39 | all 60 | subjects under 300 ms |\n|---|---:|---:|---|\n| Type 1 detection alone | 84.4 | 65.5 | 34 of 39, 53 of 60 |\n| crawls only | 3,639.1 | 3,201.3 | none |\n| **full pipeline** (comparable to Axcess) | **22,747.5** | 23,261.2 | none |\n\n- Medians and min–max for each scope are in the new tables in `KAFE-MATRIX.md` and `FINAL-REPORT.md` §7.\n- The full pipeline averages 19.33 min per subject; the paper says 19.22.\n- Type 2 detection is counted nowhere.\n- Proxy start-up is 44.6% of KAFE's full pipeline on the 39. Axcess times don't include it, but every Axcess row is still cheaper even with it removed.\n- **Faster than KAFE:** 48 of 48 Axcess rows on the full pipeline (46 of 46 with defined precision). On detection alone it's 30 of 48 (28 of 46), labelled as not comparable.\n\n## Two conflicts in the brief, and how I resolved them\n1. **\"No number in any table may change\" against \"Don't use 25.7 anywhere\".** I followed the update and changed the KAFE row's timing cells. No Axcess or accuracy number moved.\n2. **Where 25.7 still appears.** It appears only in the §8.4 corrections entry, which has to name the figure it withdraws. I removed the 0.5 ms figure completely.\n\n## Every cell that changed\n- **`KAFE-MATRIX.md`:** the KAFE row's `ms/button` (25.7 → 22747.5), `ms/subject` (1012.7 → 897652.7) and `ms covers`. New columns: `unk pos`, `unk neg`, `strict recall`. Relabelled: `recall (decided)` and `F1 (decided recall)`.\n- **`FINAL-REPORT.md` §5.1:** the unknown pos, unknown neg and strict-recall cells of all 48 Axcess rows (below). The KAFE row's strict recall went from n/a to 100.0%, its ms from 25.7 to 22747.5, and its timing scope changed. Elsewhere: two rows in the §4 legend, the KAFE row of §4's denominator table, and the KAFE row of §7's 300 ms table.\n\n  | rows | unknown pos / neg | strict recall (decided recall) |\n  |---|---|---|\n  | D0, D8 | 2 / 1 | 70.8% (77.3%) |\n  | D1, D6 | 2 / 2 | 8.3% (9.1%) |\n  | D1x | 1 / 2 | 91.7% (95.7%) |\n  | D2 | 2 / 2 | 20.8% (22.7%) |\n  | D2b | 2 / 2 | 50.0% (54.5%) |\n  | D3 | 2 / 2 | 37.5% (40.9%) |\n  | D4 | 0 / 1 | 100.0% (100.0%) |\n  | D5 | 2 / 2 | 83.3% (90.9%) |\n  | D7 | 2 / 2 | 0.0% (0.0%) |\n  | U-D0, U-D6 | 3 / 0 | 45.8% (52.4%) |\n  | U-D1 | 3 / 0 | 83.3% (95.2%) |\n  | U-D2 | 3 / 0 | 16.7% (19.0%) |\n  | U-D2b | 3 / 0 | 37.5% (42.9%) |\n  | U-D3 | 3 / 0 | 29.2% (33.3%) |\n  | U-D4, C1–C4, C7–C9 | 3 / 0 | 87.5% (100.0%) |\n  | U-D5 | 3 / 0 | 66.7% (76.2%) |\n  | U-D7 | 3 / 0 | 0.0% (0.0%) |\n  | U-D8 | 3 / 0 | 62.5% (71.4%) |\n  | C5 | 3 / 0 | 12.5% (14.3%) |\n  | C6 | 4 / 1 | 0.0% (0.0%) |\n  | C10–C14 | 3 / 0 | 79.2% (90.5%) |\n  | C15, C16 | 3 / 1 | 75.0% (85.7%) |\n  | D9 | 2 / 7 | 91.7% (100.0%) |\n  | D9+S4ours | 1 / 7 | 95.8% (100.0%) |\n  | D9+S4u, D9-noS4 | 0 / 3 | 100.0% (100.0%) |\n  | D9u, D9u+S4u | 5 / 3 | 79.2% (100.0%) |\n  | D10a, D10a+base, D10b | 0 / 0 | 100.0% (100.0%) |\n  | D10a-u | 9 / 7 | 58.3% (93.3%) |\n  | D10b-u | 7 / 5 | 70.8% (100.0%) |\n\n- **`KAFE-HIGHLIGHTS.md`:** KAFE's headline ms is now 22747.5. Strict-recall columns were added, and the cost table was rebuilt.\n- **Unchanged everywhere:** TP, FP, FN, TN, `abst.`, precision, F1 and every Axcess ms cell. I checked this cell by cell against the committed versions.\n\n## Recall claims that change\n- C12's strict recall is 79.2% (19/24), which confirms the manager's figure.\n- D9+S4ours has **95.8% strict recall, not 100%**. With strict recall its F1 would be 83.6%, still the best Axcess row.\n- 19 detectors reach 100% recall over the subjects they decided, but only 6 reach 100% strict recall.\n- Every F1 on KAFE's corpus uses recall over decided subjects, and the reports now say so.\n\nThe other changed files are the generator (`tools/kafe_matrix.py`) and the files regenerated with `assemble` and `report`: `KAFE-MATRIX-REPORT.md` and the three `derived/kafe_matrix_*.json` files. `tests/test_capdiag.py` passes (8 tests).","ttft_ms":2351,"type":"result","duration_ms":1446836,"uuid":"4d29d6fe-53e7-4725-9ab4-40a7edc3587b","ttft_stream_ms":2276,"time_to_request_ms":154,"first_content_frame_ms":2276,"queued_turn_count":0,"result_index":0}
