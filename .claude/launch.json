{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "site",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8090",
        "--bind",
        "127.0.0.1",
        "--directory",
        "site"
      ],
      "port": 8090
    },
    {
      "name": "api",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "uvicorn",
        "audit.web.server:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8765",
        "--reload"
      ],
      "port": 8765
    },
    {
      "name": "app",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "src/audit/web/frontend",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "api-open",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "uvicorn",
        "audit.web.server:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8799"
      ],
      "port": 8799
    }
  ]
}
