    text-underline-offset: 0.2em;
  }
  .os-tablist [role="tab"][aria-selected="true"] {
    background: var(--ax-inverse-bg);
    color: var(--ax-inverse-fg);
    text-decoration: none;
  }
  /* The fill is dropped in forced colours, so the selected tab also gets an
     outline there, as in the app. */
  @media (forced-colors: active) {
    .os-tablist [role="tab"][aria-selected="true"] {
      outline: 2px solid;
      outline-offset: -2px;
    }
  }
  /* Printing shows every system. */
  @media print {
    .os-panel[hidden] {
      display: block !important;
      content-visibility: visible !important;
    }
    :global(.ax-js) .os-tablist,
    :global(.ax-js) .os-note {
      display: none;
    }
  }
  .os-panel > h3 {
    padding-top: 1rem;
  }
  /* Each part, and each system's steps, starts at a thin rule, the same
     separation as the home page's numbered groups: on a long page it shows
     where one part ends without adding boxes or colour. */
  .gs > h2:not(#download),
  .gs > h3 {
    padding-top: 2rem;
    border-top: 1px solid var(--ax-border);
  }
  .report-shot {
    margin: 1.5rem 0;
  }
  .report-shot figcaption {
    margin-top: 0.5rem;
    color: var(--ax-fg-muted);
    font-size: 0.9375rem;
  }
  /* The step menu: four numbered links in a row, wrapping on a phone. */
  .step-nav ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
    counter-reset: gs-step;
  }
  .step-nav li {
    counter-increment: gs-step;
  }
  .step-nav a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: var(--ax-target);
    padding: 0 0.875rem 0 0.375rem;
    border: 1px solid var(--ax-border);
    border-radius: 999px;
    color: var(--ax-fg);
    font-weight: 600;
    text-decoration: none;
  }
  .step-nav a::before {
    content: counter(gs-step);
    display: inline-grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    background: var(--ax-inverse-bg);
    color: var(--ax-inverse-fg);
    font-size: 0.875rem;
  }
  .step-nav a:hover {
    border-color: var(--ax-fg);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  /* Choose your computer: three link cards in a row. */
  .systems {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
    gap: 0.75rem;
    margin: 1.5rem 0 0.5rem;
  }
  .systems a {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    min-height: var(--ax-target);
    padding: 1rem 1.25rem;
    border: 1px solid var(--ax-border);
    border-radius: 0.75rem;
    background: var(--ax-surface-subtle);
    color: var(--ax-fg);
    text-decoration: none;
  }
  .systems strong {
    font-size: 1.125rem;
  }
  .systems span {
    color: var(--ax-fg-muted);
    font-size: 0.9375rem;
  }
  .systems a:hover {
    border-color: var(--ax-fg);
  }
  .systems a:hover strong {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  /* A drawing step: its words and its drawing side by side on a wide
     screen, so the reader matches the words to the picture without
     scrolling between them; stacked below 56rem, where side by side would
     squeeze both. The <li> keeps its list number. */
  .step-row {
    display: grid;
    gap: 0.75rem 2rem;
  }
  @media (min-width: 56rem) {
    .step-row {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      align-items: start;
    }
  }
  /* First-scan steps: numbered panels. The number comes from a CSS counter
     on the <ol>, so the list keeps its meaning without the styles. */
  .steps {
    counter-reset: step;
    display: grid;
    gap: 1rem;
    margin: 1.5rem 0;
    padding: 0;
    list-style: none;
  }
  .steps > li {
    position: relative;
    min-width: 0;
    padding: 1.25rem 1.25rem 1.25rem 4.25rem;
    border: 1px solid var(--ax-border);
    border-radius: 0.75rem;
    background: var(--ax-surface-subtle);
  }
  .steps > li::before {
    counter-increment: step;
    content: counter(step);
    position: absolute;
    top: 1.15rem;
    left: 1.25rem;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--ax-inverse-bg);
    color: var(--ax-inverse-fg);
    font-weight: 700;
  }
  .steps h3 {
    margin: 0 0 0.375rem;
    color: var(--ax-fg);
    font-size: 1.1875rem;
    line-height: 1.3;
  }
  .steps p {
    margin: 0;
    color: var(--ax-fg-muted);
    line-height: 1.6;
  }
  .steps code {
    overflow-wrap: anywhere;
    padding: 0.1em 0.35em;
    border-radius: 0.25rem;
    background: var(--ax-surface-muted);
    color: var(--ax-fg);
    font-family: var(--sl-font-mono);
    font-size: 0.875em;
  }
  .steps .tip {
    margin-top: 0.75rem;
    padding: 0.5rem 0.75rem;
    border-inline-start: 4px solid var(--ax-maize);
    border-radius: 0.25rem;
    background: var(--ax-surface-muted);
    color: var(--ax-fg);
  }
  /* A screenshot is never larger than its own size (a small crop blown up
     would blur) and never wider than its step. No CSS width: the width
     attribute sets it, and with height: auto the browser reserves the
     picture's space from width and height before it loads. */
  .step-shot {
    display: block;
    max-width: 100%;
    height: auto;
    margin-top: 0.875rem;
    border: 1px solid var(--ax-border-strong);
    border-radius: 0.5rem;
  }
  /* On a wide screen a step's words sit beside its screenshot, as the
     install steps sit beside their drawings, so the two parts of the page
     read the same way and the reader never scrolls between a step and its
     picture. The screenshot spans the step's rows; the words stay at the
     top. */
  @media (min-width: 56rem) {
    .steps > li:has(.step-shot) {
      display: grid;
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      grid-template-rows: auto auto auto 1fr;
      column-gap: 2rem;
      align-items: start;
    }
    .steps > li > :not(.step-shot) {
      grid-column: 1;
    }
    .steps > li > .step-shot {
      grid-column: 2;
      grid-row: 1 / -1;
      margin-top: 0;
    }
  }
  /* On a phone, the screenshot also uses the space under the step number:
     every pixel makes its words easier to read. The text keeps its indent. */
  @media (max-width: 37.5rem) {
    .steps > li {
      padding-left: 3.75rem;
    }
    .steps > li::before {
      left: 0.875rem;
    }
    .step-shot {
      margin-left: -2.75rem;
      max-width: calc(100% + 2.75rem);
    }
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: 1rem;
    margin: 1.5rem 0;
  }

  /* Three cards would leave one alone on a second row in the 48rem
     column, which reads as an afterthought; stacked, they read in order. */
  .facts.stack {
    grid-template-columns: 1fr;
  }

  .install-steps > li + li {
    margin-top: 0.75rem;
  }

  /* -------------------------------------------------------------------
   * Install drawings. Why they are HTML, how a screen reader gets them,
   * and why the marks look as they do: see the comment in the frontmatter.
   *
   * Colours: the window, its text and its lines use the site's --ax-*
   * tokens, so a drawing follows the light or dark theme the way macOS and
   * Windows follow theirs, and its text keeps 7:1 in both. The parts that
   * are blue on the real screen in either theme (the SmartScreen window,
   * Setup's title bar, the macOS default button) keep a fixed blue with
   * white text, each 7.2:1 or more. Sizes are in em, so a drawing grows
   * with the text, and the drawing's own width (a container query) decides
   * when its parts stack.
   * ----------------------------------------------------------------- */
  .mock {
    --mock-win: var(--ax-surface);
    --mock-bar: var(--ax-surface-muted);
    --mock-page: var(--ax-surface-subtle);
    --mock-line: var(--ax-border-strong);
    --mock-faint: var(--ax-border);
    --mock-fg: var(--ax-fg);
    --mock-fg-muted: var(--ax-fg-muted);
    --mock-mark: var(--ax-focus);
    container-type: inline-size;
    margin: 0.75rem 0 1.25rem;
    color: var(--mock-fg);
    font-family: var(--sl-font);
    font-size: 0.875rem;
    line-height: 1.45;
    letter-spacing: 0;
  }
  .mock p {
    margin: 0 0 0.5rem;
    color: inherit;
  }
  .mock p:last-child {
    margin-bottom: 0;
  }
  .mock ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .mock code {
    padding: 0;
    background: none;
    color: inherit;
    font: inherit;
    font-weight: 700;
    overflow-wrap: anywhere;
  }
  .mock-win {
    border: 1px solid var(--mock-line);
    border-radius: 12px;
    background: var(--mock-win);
    box-shadow: var(--ax-shadow);
  }
  .mock-flat {
    border-radius: 4px;
  }
  /* No overflow: hidden on the window, so a step number near the edge is
     never cut off; the first and last parts round themselves. */
  .mock-bar,
  .mock-head,
  .mock-titlebar {
    border-top-left-radius: inherit;
    border-top-right-radius: inherit;
  }
  .mock-foot {
    border-bottom-left-radius: inherit;
    border-bottom-right-radius: inherit;
  }
  .mock-bar {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.35rem 0.7rem;
    border-bottom: 1px solid var(--mock-faint);
    background: var(--mock-bar);
  }
  .mock-bar-title {
    flex: 1;
    font-weight: 600;
  }
  .mock-dots {
    display: inline-flex;
    gap: 0.3rem;
  }
  .mock-dots i {
    width: 0.7em;
    height: 0.7em;
    border-radius: 50%;
    background: #ff5f57;
  }
  .mock-dots i:nth-child(2) {
    background: #febc2e;
  }
  .mock-dots i:nth-child(3) {
    background: #28c840;
  }
  .mock-pad {
    padding: 0.8rem 0.9rem;
  }
  .mock-title {
    font-size: 1.08em;
    font-weight: 700;
  }
  .mock-row {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.7rem;
  }
  /* 10em before it wraps: a narrow drawing puts the button under the text
     rather than squeezing the text to one word per line. */
  .mock-grow {
    flex: 1 1 10em;
    min-width: 0;
  }
  .mock-path,
  .mock-field {
    overflow-wrap: anywhere;
  }
  .mock-btn {
    display: inline-block;
    padding: 0.25em 0.85em;
    border: 1px solid var(--mock-line);
    border-radius: 6px;
    background: var(--mock-win);
    color: var(--mock-fg);
    font-weight: 600;
    white-space: nowrap;
  }
  .mock-btn-mac {
    border-color: #0050c0;
    background: #0050c0;
    color: #fff;
  }
  .mock-btn-pale {
    border-color: var(--mock-bar);
    background: var(--mock-bar);
  }
  .mock-btn-icon {
    padding: 0.1em 0.6em;
    font-size: 1.1em;
  }
  .mock-btns {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.5rem;
  }
  .mock-stack {
    display: grid;
    gap: 0.5rem;
  }
  .mock-stack .mock-btn {
    text-align: center;
  }

  /* The mark: an outline in the theme's focus colour outside a maize ring.
     An outline, not only a shadow, because a high-contrast theme keeps
     outlines and drops shadows. */
  .mock-mark {
    position: relative;
    display: inline-block;
    outline: 3px solid var(--mock-mark);
    outline-offset: 3px;
    border-radius: 6px;
    box-shadow: 0 0 0 3px var(--ax-maize);
  }
  .mock-mark::after {
    content: attr(data-step);
    position: absolute;
    top: -1.15em;
    right: -1.1em;
    z-index: 1;
    display: grid;
    place-items: center;
    min-width: 1.6em;
    height: 1.6em;
    border: 2px solid var(--ax-maize);
    border-radius: 50%;
    background: var(--ax-inverse-bg);
    color: var(--ax-inverse-fg);
    font: 700 0.8rem/1 var(--sl-font);
  }

  /* macOS: the disk image window */
  .mock-drag {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem 1.4rem;
    padding: 1.4rem 1rem 1.1rem;
  }
  .mock-icon {
    display: inline-grid;
    justify-items: center;
    gap: 0.3rem;
    padding: 0.3rem 0.4rem;
  }
  /* The real app icon (desktop/assets/axcess.svg): the navy mark on a light
     tile, in both themes, because that is the icon people will see. */
  .mock-app {
    display: grid;
    place-items: center;
    width: 3.2em;
    height: 3.2em;
    border: 1px solid #aab3bf;
    border-radius: 22%;
    background: #f2f5f9;
    color: #00274c;
    box-shadow: 0 1px 3px rgb(0 39 76 / 0.18);
  }
  .mock-app :global(svg) {
    width: 60%;
    height: 60%;
  }
  .mock-folder {
    position: relative;
    width: 3.4em;
    height: 2.6em;
    margin-top: 0.6em;
    border-radius: 4px;
    background: #5aa9e6;
  }
  .mock-folder::before {
    content: "";
    position: absolute;
    top: -0.45em;
    left: 0;
    width: 45%;
    height: 0.6em;
    border-radius: 4px 4px 0 0;
    background: #5aa9e6;
  }
  .mock-arrow {
    width: 3em;
    color: var(--mock-fg);
  }

  /* macOS: the warning message */
  .mock-alert {
    max-width: 17rem;
    margin: 0 auto;
    padding: 1rem;
    background: var(--mock-page);
    text-align: center;
  }
  .mock-alert .mock-app {
    margin: 0 auto 0.6rem;
  }

  /* macOS: System Settings */
  .mock-settings {
    display: grid;
    grid-template-columns: minmax(8.5rem, 38%) 1fr;
  }
  .mock-side {
    padding: 0.6rem 0.5rem;
    border-right: 1px solid var(--mock-faint);
    border-radius: 12px 0 0 12px;
    background: var(--mock-bar);
  }
  .mock-side .mock-dots {
    margin: 0 0 0.6rem 0.3rem;
  }
  .mock-side li {
    padding: 0.2rem 0.45rem;
  }
  .mock-selected {
    display: block;
    margin: 0.15rem -0.45rem;
    padding: 0.2rem 0.45rem;
    background: #0050c0;
    color: #fff;
    font-weight: 600;
  }
  /* The selected row is as wide as the list, so its number sits inside the
     row's end, not past the drawing's edge. */
  .mock-selected::after {
    right: 0.3em;
  }
  /* A setting whose name the drawing leaves out: a grey bar. */
  .mock-hidden {
    display: inline-block;
    width: 6em;
    height: 0.6em;
    border-radius: 4px;
    background: var(--mock-faint);
    vertical-align: middle;
  }
  .mock-main {
    min-width: 0;
    padding: 0.7rem 0.8rem;
  }
  .mock-group {
    padding: 0.55rem 0.65rem;
    border: 1px solid var(--mock-faint);
    border-radius: 8px;
    background: var(--mock-page);
  }
  .mock-faint {
    display: grid;
    gap: 0.45rem;
  }
  .mock-faint i {
    display: block;
    height: 0.55em;
    border-radius: 4px;
    background: var(--mock-faint);
  }
  .mock-faint i:nth-child(2) {
    width: 80%;
  }
  .mock-faint i:nth-child(3) {
    width: 60%;
  }
  .mock .mock-scroll {
    margin: 0.5rem 0;
    color: var(--mock-fg-muted);
    font-style: italic;
    text-align: center;
  }
  .mock-heading {
    margin-bottom: 0.35rem;
    font-weight: 700;
  }
  @container (max-width: 22rem) {
    .mock-settings {
      grid-template-columns: 1fr;
    }
    .mock-side {
      border-right: 0;
      border-bottom: 1px solid var(--mock-faint);
      border-radius: 12px 12px 0 0;
    }
    .mock-row {
      flex-wrap: wrap;
    }
  }

  /* Windows: the browser's downloads list */
  .mock-warn {
    flex: none;
    display: grid;
    place-items: center;
    width: 1.5em;
    height: 1.5em;
    border-radius: 50%;
    background: #fde7b0;
    color: #5c3b00;
    font-weight: 800;
  }
  .mock-menu {
    width: max-content;
    max-width: calc(100% - 1.8rem);
    margin: 0 0.9rem 0.9rem auto !important;
    padding: 0.35rem 0 !important;
    border: 1px solid var(--mock-line);
    border-radius: 6px;
    background: var(--mock-win);
    box-shadow: var(--ax-shadow);
  }
  .mock-menu li {
    padding: 0.3rem 1rem;
  }
  .mock-menu .mock-mark {
    padding: 0 0.4rem;
  }

  /* Windows: the blue SmartScreen window. Blue in both themes, as on the
     real screen; white text on it is 9:1. */
  .mock-pair {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    gap: 1rem;
  }
  .mock .mock-label {
    margin-bottom: 0.35rem;
    color: var(--mock-fg);
    font-weight: 700;
  }
  .mock-blue {
    padding: 0.9rem;
    border-color: #0a4a87;
    background: #0a4a87;
    color: #fff;
  }
  .mock-blue .mock-title {
    font-size: 1.3em;
    font-weight: 400;
  }
  .mock-blue .mock-btn {
    border-color: #fff;
    border-radius: 2px;
    background: transparent;
    color: #fff;
  }
  .mock-blue .mock-btns {
    margin-top: 0.9rem;
  }
  .mock-link {
    padding: 0 0.15rem;
    text-decoration: underline;
  }

  /* Windows: Axcess Setup. The title bar blue is darker than Windows'
     accent so its white text keeps 7:1 (8.2:1). Setup's greyed-out buttons
     keep 7:1 text too, and show that they are off by a fainter border. */
  .mock-titlebar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3rem 0.6rem;
    background: #0b4f94;
    color: #fff;
  }
  .mock-titlebar .mock-bar-title {
    font-weight: 400;
  }
  .mock-title-icon {
    display: grid;
    place-items: center;
    width: 1.25em;
    height: 1.25em;
    border-radius: 3px;
    background: #fff;
    color: #00274c;
  }
  .mock-title-icon :global(svg) {
    width: 80%;
    height: 80%;
  }
  .mock-controls {
    display: flex;
    gap: 1.1em;
  }
  .mock-controls i {
    font-style: normal;
  }
  .mock-setup .mock-pad {
    background: var(--mock-page);
  }
  .mock-head {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.6rem 0.9rem;
    border-bottom: 1px solid var(--mock-faint);
    background: var(--mock-win);
  }
  .mock-head p:not(.mock-title) {
    padding-left: 0.7rem;
    color: var(--mock-fg-muted);
  }
  .mock-head-logo {
    flex: none;
    width: 1.9em;
    height: 1.9em;
    color: var(--ax-link);
  }
  .mock-foot {
    padding: 0.7rem 0.9rem;
    border-top: 1px solid var(--mock-faint);
    background: var(--mock-bar);
  }
  .mock-btn-win {
    min-width: 5.5em;
    padding: 0.25em 1em;
    border-radius: 4px;
    font-weight: 400;
    text-align: center;
  }
  .mock-btn-default {
    border: 2px solid var(--ax-link);
  }
  .mock-off {
    border-color: var(--mock-faint);
    background: var(--mock-page);
    color: var(--mock-fg-muted);
  }
  .mock-radio,
  .mock-check {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }
  .mock-radio {
    margin-left: 1.6rem;
  }
  .mock-radio::before {
    content: "";
    flex: none;
    width: 1em;
    height: 1em;
    border: 1px solid var(--mock-fg-muted);
    border-radius: 50%;
    background: var(--mock-win);
  }
  .mock-on::before {
    border: 0;
    background: radial-gradient(circle, var(--mock-win) 0 28%, var(--ax-link) 32%);
  }
  .mock-check::before {
    content: "✓";
    flex: none;
    display: grid;
    place-items: center;
    width: 1.1em;
    height: 1.1em;
    border-radius: 3px;
    background: var(--ax-link);
    color: var(--mock-win);
    font-weight: 800;
    line-height: 1;
  }
  .mock-radio .mock-mark {
    padding: 0 0.3rem;
  }
  .mock .mock-note {
    margin-top: 0.9rem;
    color: var(--mock-fg-muted);
  }
  .mock-field-label {
    margin-bottom: 0.25rem;
  }
  .mock-field {
    padding: 0.25rem 0.5rem;
    border: 1px solid var(--mock-line);
    border-bottom: 2px solid var(--ax-link);
    border-radius: 3px;
    background: var(--mock-win);
  }
  .mock-finish {
    display: grid;
    grid-template-columns: minmax(3.5rem, 30%) 1fr;
    background: var(--mock-win);
  }
  .mock-setup .mock-finish .mock-pad {
    background: var(--mock-win);
  }
  .mock-title-big {
    font-size: 1.3em;
  }
  .mock-panel {
    display: grid;
    place-items: center;
    padding: 0.8rem;
    background: #0b4f94;
    color: #fff;
  }
