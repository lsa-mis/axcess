<script>
  // Mac, Windows and Linux tabs (see the comment above the tab list).
  const root = document.querySelector<HTMLElement>("[data-os-tabs]");
  if (root) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = tabs.map((tab) => document.getElementById(tab.getAttribute("aria-controls") ?? ""));
    const ids = panels.map((panel) => panel?.id ?? "");

    const select = (id: string, focus = false) => {
      tabs.forEach((tab, i) => {
        const on = ids[i] === id;
        tab.setAttribute("aria-selected", String(on));
        tab.tabIndex = on ? 0 : -1;
        if (on) panels[i]?.removeAttribute("hidden");
        else panels[i]?.setAttribute("hidden", "until-found");
        if (on && focus) tab.focus();
      });
    };

    panels.forEach((panel, i) => {
      if (!panel) return;
      panel.setAttribute("role", "tabpanel");
      panel.setAttribute("aria-labelledby", tabs[i].id);
      panel.tabIndex = 0;
      // Find-in-page opened a hidden system: make its tab the selected one.
      panel.addEventListener("beforematch", () => select(panel.id));
    });

    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => select(ids[i]));
      tab.addEventListener("keydown", (event) => {
        const last = tabs.length - 1;
        const next =
          event.key === "ArrowRight" ? (i === last ? 0 : i + 1)
          : event.key === "ArrowLeft" ? (i === 0 ? last : i - 1)
          : event.key === "Home" ? 0
          : event.key === "End" ? last
          : null;
        if (next === null) return;
        event.preventDefault();
        select(ids[next], true);
      });
    });

    const fromHash = () => {
      const id = location.hash.slice(1);
      return ids.includes(id) ? id : null;
    };
    const detected = () => {
      const nav = navigator as Navigator & { userAgentData?: { platform?: string } };
      const name = (nav.userAgentData?.platform || navigator.platform || navigator.userAgent).toLowerCase();
      if (name.includes("win")) return "windows";
      if (name.includes("linux") && !/android/i.test(navigator.userAgent)) return "linux";
      return "mac";
    };
    select(fromHash() ?? detected());
    window.addEventListener("hashchange", () => {
      const id = fromHash();
      if (!id) return;
      select(id);
      document.getElementById(id)?.scrollIntoView();
    });
  }
</script>

