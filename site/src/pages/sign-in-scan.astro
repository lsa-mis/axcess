---
/**
 * Scan a site behind a sign-in (/sign-in-scan/).
 *
 * What: the steps for a sign-in scan, with screenshots, and the three facts
 * people ask about it (what it needs, what is saved, what is different).
 * Moved here unchanged from Get started, which now links here
 * (developer's direction, 2026-10-06; see get-started.astro). Every app
 * word is the app's own (newScan/copy.ts, LocalLoginScan.tsx);
 * tests/public_site checks them.
 */
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import Card from "../components/Card.astro";
import { url } from "../lib/site";

/*
 * Screenshots of Axcess itself, beside the first-scan steps.
 *
 * Why screenshots here when the install steps use drawings: Axcess is our
 * own app, so a screenshot is exactly what people will see, and it is cheap
 * to retake. A screenshot shrinks rather than reflows at 320 px, so it never
 * carries anything the step text leaves out; the words are always in the
 * text too (SC 1.4.5 Images of Text, Level AA, allows pictures whose words
 * are also given as text; paraphrase). Each alt text says what the picture
 * shows and where the thing to choose is (SC 1.1.1 Non-text Content, Level
 * A). Width and height reserve its space so the steps do not jump. Left out
 * on purpose: a site's own sign-in page, which looks different for every
 * organization. Retake a screenshot when the words on its screen change.
 */
const shots = {
  "sign-in-tab": {
    w: 630,
    h: 170,
    alt: "The top of the New scan page. The second tab, Site with a sign-in or two-step sign-in (2FA), is chosen, beside the Public website tab.",
  },
  "sign-in-address": {
    w: 997,
    h: 456,
    alt: "The address https://umich.instructure.com/ in the box Website address to scan after you sign in. Below it, a check mark and the words: Will scan umich.instructure.com/ and every page under it, after you sign in. Below that, the box is checked that says the site owner allows this scan and you will sign in with a test account that has only the access it needs.",
  },
  "signed-in-start": {
    w: 970,
    h: 418,
    alt: "The Finished signing in? box. It lists what happens when you start, and the button I\u2019m signed in, start scan is at its bottom left.",
  },
} as const;
type Shot = keyof typeof shots;
const shot = (name: Shot) => ({
  src: url(`/screens/${name}.png`),
  width: shots[name].w,
  height: shots[name].h,
  alt: shots[name].alt,
});
---

<StarlightPage
  headings={[
    { depth: 2, slug: "steps", text: "Sign in and scan, step by step" },
    { depth: 2, slug: "what-to-know", text: "What to know" },
  ]}
  frontmatter={{
    title: "Scan a site behind a sign-in",
    description:
      "Scan pages behind a sign-in, including U-M sign-in and Duo, from the Axcess desktop app. You sign in yourself; Axcess never sees your password.",
  }}
>
  <p>
    When you are comfortable, try a site that needs a sign-in. You sign in yourself, in a browser window on your
    computer, so U-M sign-in and Duo two-step sign-in work, and Axcess never sees your password. Your sign-in is
    deleted when the scan ends.
  </p>
  <p>
    Sign-in scans work only when Axcess runs on your own computer: the desktop app, or Axcess run from the source
    code. They are not available when Axcess runs on a shared server for a team.
  </p>
  <h2 id="steps">Sign in and scan, step by step</h2>
  <ol class="not-content ax-prose steps">
    <li>
      <h3>Choose the sign-in tab</h3>
      <p>Select <em>New scan</em>, then the <em>Site with a sign-in or two-step sign-in (2FA)</em> tab.</p>
      <img class="step-shot" loading="lazy" {...shot("sign-in-tab")} />
    </li>
    <li>
      <h3>Enter where to start, and confirm you may scan</h3>
      <p>
        In <em>Website address to scan after you sign in</em>, enter the address of the page the scan should start
        from. It must start with https://. Axcess shows which pages it will scan. Then check the box that says the
        site owner allows this scan and that you will sign in with a test account that has only the access it
        needs.
      </p>
      <img class="step-shot" loading="lazy" {...shot("sign-in-address")} />
    </li>
    <li>
      <h3>Sign in in the browser window</h3>
      <p>
        Select <em>Open browser to sign in</em>. A browser window opens at the site's own sign-in page, which looks
        different for every organization. Sign in there as you usually do, including any two-step sign-in. If
        sign-in opens a new tab, finish in that tab. You are done when the browser shows the site itself, not a
        sign-in page.
      </p>
      <p>
        To stop without scanning, select <em>Cancel sign-in</em> in Axcess. Nothing is recorded until you start the
        scan. If you close the sign-in window before you start, Axcess keeps your sign-in for 30 minutes, in memory
        only: you can still start the scan, or select <em>Reopen sign-in window</em>.
        <a href={url("/docs/troubleshooting/#i-closed-the-sign-in-window-before-starting")}>If you closed the
        sign-in window</a>.
      </p>
    </li>
    <li>
      <h3>Start the scan</h3>
      <p>
        Come back to Axcess. Under <em>Finished signing in?</em>, select <em>I’m signed in, start scan</em>. The
        scan starts from the page in the newest tab that is still open in the browser, or, if you closed the
        window, from the last page you were on. If that page is outside the
        address you entered, the scan starts from that address instead. Either way, it stays inside the address you
        entered.
      </p>
      <img class="step-shot" loading="lazy" {...shot("signed-in-start")} />
    </li>
  </ol>

  {
    /* Three short cards for the three questions people ask about a
       sign-in scan (what it needs, what it keeps, what is different), so
       no limit or privacy fact is lost in a long paragraph (COGA "Making
       Content Usable": one idea per chunk; the repo's rule never to drop
       a limitation). Card is the shared panel used on every page (SC 3.2.4
       Consistent Identification, Level AA). */
  }
  <h2 id="what-to-know">What to know</h2>
  <div class="not-content ax-prose facts stack">
    <Card heading="What it needs">
      <p>
        A site whose address starts with https://, uses a name (not a number such as an IP address), and points to
        a public internet address. Sites on a private network address can't be scanned this way.
      </p>
    </Card>
    <Card heading="What is saved">
      <p>
        The report on your computer keeps a saved copy of each page you signed in to, and screenshots. To leave out
        the saved copies, choose <em>Don’t keep a saved copy of each page</em>. Axcess never saves your password or
        your sign-in.
      </p>
    </Card>
    <Card heading="What is different">
      <p>
        Sign-in scans skip the site's robots.txt file (where a site asks scanners to stay away from pages). Your
        confirmation that the site owner allows the scan takes its place. They don't run AI review or the Motion
        and reading-order check, and the Image text check is off unless you turn it on. If Axcess closes during a
        sign-in scan, start a new one.
      </p>
    </Card>
  </div>

  <p>
    New to Axcess? Start with <a href={url("/get-started/")}>Get started</a> and a small public scan first.
  </p>
</StarlightPage>

<style>
  /* First-scan steps: numbered panels. The number comes from a CSS counter
     on the <ol>, so the list keeps its meaning without the styles. */
  .steps {
    counter-reset: step;
    display: grid;
    gap: 1rem;
    margin: 1.5rem 0;
    padding: 0;
    list-style: none;
  }
  .steps > li {
    position: relative;
    min-width: 0;
    padding: 1.25rem 1.25rem 1.25rem 4.25rem;
    border: 1px solid var(--ax-border);
    border-radius: 0.75rem;
    background: var(--ax-surface-subtle);
  }
  .steps > li::before {
    counter-increment: step;
    content: counter(step);
    position: absolute;
    top: 1.15rem;
    left: 1.25rem;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--ax-inverse-bg);
    color: var(--ax-inverse-fg);
    font-weight: 700;
  }
  .steps h3 {
    margin: 0 0 0.375rem;
    color: var(--ax-fg);
    font-size: 1.1875rem;
    line-height: 1.3;
  }
  .steps p {
    margin: 0;
    color: var(--ax-fg-muted);
    line-height: 1.6;
  }
  .steps code {
    overflow-wrap: anywhere;
    padding: 0.1em 0.35em;
    border-radius: 0.25rem;
    background: var(--ax-surface-muted);
    color: var(--ax-fg);
    font-family: var(--sl-font-mono);
    font-size: 0.875em;
  }
  .steps .tip {
    margin-top: 0.75rem;
    padding: 0.5rem 0.75rem;
    border-inline-start: 4px solid var(--ax-maize);
    border-radius: 0.25rem;
    background: var(--ax-surface-muted);
    color: var(--ax-fg);
  }
  /* A screenshot is never larger than its own size (a small crop blown up
     would blur) and never wider than its step. No CSS width: the width
     attribute sets it, and with height: auto the browser reserves the
     picture's space from width and height before it loads. */
  .step-shot {
    display: block;
    max-width: 100%;
    height: auto;
    margin-top: 0.875rem;
    border: 1px solid var(--ax-border-strong);
    border-radius: 0.5rem;
  }
  /* On a phone, the screenshot also uses the space under the step number:
     every pixel makes its words easier to read. The text keeps its indent. */
  @media (max-width: 37.5rem) {
    .steps > li {
      padding-left: 3.75rem;
    }
    .steps > li::before {
      left: 0.875rem;
    }
    .step-shot {
      margin-left: -2.75rem;
      max-width: calc(100% + 2.75rem);
    }
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: 1rem;
    margin: 1.5rem 0;
  }

  /* Three cards would leave one alone on a second row in the 48rem
     column, which reads as an afterthought; stacked, they read in order. */
  .facts.stack {
    grid-template-columns: 1fr;
  }

</style>
