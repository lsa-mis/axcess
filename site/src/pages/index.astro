---
/**
 * Home page.
 *
 * Order follows the questions a visitor asks, in turn (Articulating Design
 * Decisions, 2nd ed.: lead with the outcome people care about, then answer
 * objections): what is it (hero), what does it find that I'm missing
 * (catches), what can't it do (coverage, said plainly and with the real
 * numbers), how is it different (comparison), why now (Title II), the
 * remaining doubts (questions), and what to do next (download or share).
 *
 * Rejected from the v3 draft: a "You can see exactly what was tested"
 * section. Its stage names did not match the app (the app shows Find pages,
 * Check pages, Prepare report, with a percentage) and its last step claimed
 * every page is checked against all of WCAG. The coverage section replaces
 * it with numbers taken from the product's own criterion list.
 *
 * Layout, spacing, type sizes and colours copy the v3 design artifact
 * exactly (the developer's choice): full-width bands that alternate the
 * page grey and white, a 1200 px column, and 96 px between sections. What
 * differs from the artifact, and why, is in the home page section of
 * theme.css. The artifact's own markup is kept where it is native HTML;
 * its comparison table and questions are a real <table> and <details>.
 *
 * Every number here comes from src/data/coverage.json, exported from
 * src/audit/rules/wcag_coverage.yaml by site/export_data.py, so the page
 * cannot claim coverage the code does not have.
 */
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import coverage from "../data/coverage.json";
import { QUESTIONS } from "../data/questions";
import { HONESTY, url } from "../lib/site";

const { covered, total, manualOnly } = coverage.summary;
const homeQuestions = QUESTIONS.filter((q) => ["prove", "cloud", "sign-in", "cost"].includes(q.id));

const rows = [
  {
    k: "Menus, tabs and dialogs",
    a: "Often checked only as the page first loads",
    b: "Opened, and the rule check runs again on what appears",
  },
  {
    k: "Pages behind a sign-in",
    a: "Often skipped or hard to set up",
    b: "You sign in yourself, including Duo, and they are included",
  },
  {
    k: "Getting the report",
    a: "Exported or written up later",
    b: "Ready when the scan finishes, with Excel, Markdown, CSV and JSON exports",
  },
  { k: "Finding the problem", a: "A rule name and a web address", b: "An outline on a saved copy of the page" },
  { k: "Handing off to developers", a: "Find the element yourself", b: "A copyable element locator (CSS selector)" },
  { k: "Where your data goes", a: "Often a vendor's cloud", b: "Stays on your computer" },
  { k: "What it can't check", a: "Often not stated", b: "Listed for every WCAG criterion" },
];
---

<StarlightPage
  frontmatter={{
    title: "Axcess: accessibility testing that runs on your computer",
    description:
      "A free, open-source accessibility scanner that runs on your computer. It opens menus and dialogs, checks the pages behind your sign-in, and keeps every result on your machine.",
    template: "splash",
    tableOfContents: false,
    hero: {
      title: "Test the site your users actually see.",
      tagline:
        "Many accessibility scanners only check a page as it first loads. Axcess also opens menus and dialogs, checks the pages behind your sign-in, and has your report ready when the scan finishes.",
    },
  }}
  hasSidebar={true}
>
  <div class="not-content home">
    <section class="band white" aria-labelledby="catches">
      <div class="wrap">
        <p class="eyebrow">What it catches that others don't</p>
        <h2 id="catches" class="section-title spaced">Problems hide where scanners don't look. Axcess looks there.</h2>

        <div class="groups">
          <div class="group">
            <div class="group-intro">
              <p class="group-label">01 · Less risk</p>
              <h3>Find more of what's really there</h3>
              <p>So problems don't first come to light in a complaint.</p>
            </div>
            <div class="cards">
              <div class="card">
                <h4>Opens what your users open</h4>
                <p>Menus, tabs, accordions and dialogs only appear after a click. Axcess opens them, within set limits, and runs the rule check on each page state it reaches. It skips buttons like Sign out, Delete and Buy.</p>
                <div class="proof stats">
                  <div><span class="n">194</span><span class="l">pages</span></div>
                  <div><span class="n">1,171</span><span class="l">page states opened by clicking</span></div>
                </div>
              </div>
              <div class="card">
                <h4>Checks pages behind a sign-in</h4>
                <p>Student portals, staff tools and course pages usually go untested. Sign in yourself, including U-M sign-in and Duo, and Axcess checks the pages behind it. It deletes the sign-in when the scan ends.</p>
                <p class="proof kv"><span>Pages behind a sign-in</span><strong>Included in scan</strong></p>
              </div>
            </div>
          </div>

          <div class="group">
            <div class="group-intro">
              <p class="group-label">02 · Less time</p>
              <h3>Fix it without the hunt</h3>
              <p>Designers and developers start with the answer, not a search.</p>
            </div>
            <div class="cards">
              <div class="card">
                <p class="card-label">For designers</p>
                <h4>Highlights the exact element</h4>
                <p>Each problem is outlined on a saved copy of the page, with its size and label.</p>
                <div class="proof outline-sample">
                  <span class="target" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M19 21l-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg></span>
                  <span><strong>Size</strong><br /><span class="muted">30 pixels wide, 30 pixels tall</span></span>
                </div>
              </div>
              <div class="card">
                <p class="card-label">For developers</p>
                <h4>Points to the code</h4>
                <p>Copy the element locator (CSS selector) and paste it into your browser's developer tools.</p>
                <code class="proof locator">.copy-link-btn.before.auto-heading-links</code>
              </div>
            </div>
          </div>

          <div class="group">
            <div class="group-intro">
              <p class="group-label">03 · Less friction</p>
              <h3>Move as fast as your team can</h3>
              <p>No waiting for a write-up, no cloud approvals.</p>
            </div>
            <div class="cards">
              <div class="card">
                <h4>Report ready when the scan finishes</h4>
                <p>Every issue comes with its pages, where it is on each page, and how to fix it in plain language. Export it as an Excel issue list, a written report, or a CSV or JSON file.</p>
                <div class="proof kv">
                  <strong>Scan finished · 12 Mostly sure issues</strong>
                  <span class="pill" aria-hidden="true">Open report →</span>
                </div>
              </div>
              <div class="card">
                <h4>Keeps your data local</h4>
                <p>Scans, sign-ins and reports stay on your computer, which makes IT review easier.</p>
                <p class="proof kv"><span>Where scans run</span><strong>This computer</strong></p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="band" aria-labelledby="limits">
      <div class="wrap">
        <p class="eyebrow">What it can't do</p>
        <h2 id="limits" class="section-title">Honest about what a scan can check.</h2>
        <p class="lead">No tool can test all of WCAG. Here is exactly how much Axcess helps with, so you know what a person still needs to test before you share the results.</p>
        <div class="coverage">
          <div class="figure">
            <p class="big"><span>{covered}</span> of {total}</p>
            <p>WCAG 2.2 Level A and AA criteria get help from Axcess's checks.</p>
          </div>
          <div class="figure">
            <p class="big"><span>{manualOnly}</span> of {total}</p>
            <p>need a person to test them. The report gives the steps.</p>
          </div>
          <div class="figure plain">
            <p>{HONESTY}</p>
            <a class="button secondary" href={url("/coverage/")}>See every criterion</a>
          </div>
        </div>
      </div>
    </section>

    <section class="band white" aria-labelledby="compare">
      <div class="wrap">
        <h2 id="compare" class="section-title compare-title">Compared with other scanners</h2>
        <div class="table-wrap" role="region" aria-labelledby="compare-caption" tabindex="0">
          <table>
            <caption id="compare-caption" class="sr-only">Axcess compared with many other accessibility scanners</caption>
            <thead>
              <tr>
                <th scope="col"><span class="sr-only">Topic</span></th>
                <th scope="col">Many other scanners</th>
                <th scope="col" class="ours-head">Axcess</th>
              </tr>
            </thead>
            <tbody>
              {
                rows.map((r) => (
                  <tr>
                    <th scope="row">{r.k}</th>
                    <td>{r.a}</td>
                    <td class="ours">{r.b}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="band" aria-labelledby="title-ii">
      <div class="wrap title2">
        <div>
          <p class="eyebrow">Americans with Disabilities Act (ADA) Title II</p>
          <h2 id="title-ii" class="section-title tight">You have time to do this well. Start now.</h2>
          <p class="body-lg">Public universities and state and local governments must make their web content meet WCAG 2.1 Level AA. The Department of Justice moved the deadlines back a year, but the requirements stayed the same.</p>
          <p class="body">Axcess checks against WCAG 2.1 AA by default, the level Title II requires. Its results are evidence for a person to review, not proof that you comply.</p>
        </div>
        <div>
          <div class="deadlines">
            <div class="deadline">
              <div>
                <p class="who">Population of 50,000 or more</p>
                <p class="date"><time datetime="2027-04-26">April 26, 2027</time></p>
                <p class="was">Was April 24, 2026</p>
              </div>
              <p class="countdown" data-countdown="2027-04-26"></p>
            </div>
            <div class="deadline">
              <div>
                <p class="who">Smaller entities and special district governments</p>
                <p class="date"><time datetime="2028-04-26">April 26, 2028</time></p>
                <p class="was">Was April 26, 2027</p>
              </div>
            </div>
          </div>
          <p class="source">
            Source: <a href="https://www.ada.gov/resources/2024-03-08-web-rule/">the Department of Justice's page on the Title II web and mobile app rule (ada.gov)</a>.
          </p>
        </div>
      </div>
    </section>

    <section class="band white" aria-labelledby="questions">
      <div class="wrap narrow">
        <h2 id="questions" class="section-title questions-title">Common questions</h2>
        <div class="questions">
          {
            homeQuestions.map((q) => (
              <details>
                <summary>{q.q}</summary>
                <p>{q.a}</p>
              </details>
            ))
          }
        </div>
        <p class="more"><a href={url("/faq/")}>All questions</a></p>
      </div>
    </section>

    <section class="band" aria-labelledby="next">
      <div class="wrap">
        <div class="cta ax-inverse">
          <div class="cta-copy">
            <h2 id="next">See your site the way your users do.</h2>
            <p>It's free, and your first scan takes minutes to set up. Not the one who decides? Send this page to the person who does.</p>
          </div>
          <div class="cta-actions">
            <a class="button on-cta" href={url("/get-started/#download")}>Download Axcess</a>
            <button type="button" class="button share ax-js-only" data-share>Share with my team</button>
            <p class="share-status" role="status" data-share-status></p>
          </div>
        </div>
      </div>
    </section>
  </div>
</StarlightPage>

<script>
  // Days until the first Title II date. Without scripts the date still shows.
  for (const el of document.querySelectorAll<HTMLElement>("[data-countdown]")) {
    const days = Math.ceil((new Date(`${el.dataset.countdown}T00:00:00`).getTime() - Date.now()) / 86_400_000);
    if (days > 0) el.textContent = `${days.toLocaleString()} days from today`;
  }

  // "Copy link": shown only when scripts run (class ax-js-only). The result is
  // written to a status message, so screen readers hear it (SC 4.1.3 Status
  // Messages, Level AA), and a failed copy says so instead of claiming success.
  const share = document.querySelector<HTMLButtonElement>("[data-share]");
  const status = document.querySelector<HTMLElement>("[data-share-status]");
  share?.addEventListener("click", async () => {
    if (!status) return;
    try {
      await navigator.clipboard.writeText(location.href);
      status.textContent = "Link copied. Paste it into an email or chat.";
    } catch {
      status.textContent = `Copying didn't work. The address is ${location.href}`;
    }
  });
</script>

<style>
  /* Bands and column, as in the artifact. */
  .band {
    background: var(--h-page);
  }
  .band.white {
    border-top: 1px solid var(--h-line);
    border-bottom: 1px solid var(--h-line);
    background: var(--h-band);
  }
  .wrap {
    max-width: 1200px;
    margin: 0 auto;
    padding: 96px 32px;
  }
  .wrap.narrow {
    max-width: 880px;
  }
  /* Section labels: sentence case, not the artifact's spaced capitals, by
     the developer's choice (docs/plain-language.md rule 11). */
  .eyebrow {
    margin: 0 0 12px;
    color: var(--h-label);
    font-size: 15px;
    font-weight: 700;
  }
  .section-title {
    max-width: 780px;
    margin: 0 0 16px;
    color: var(--h-text);
    font-size: clamp(30px, 3.6vw, 44px);
    line-height: 1.1;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .section-title.spaced {
    margin-bottom: 56px;
  }
  .section-title.tight {
    margin-bottom: 18px;
  }
  .compare-title {
    max-width: 760px;
    margin-bottom: 36px;
  }
  .questions-title {
    margin-bottom: 32px;
  }
  .lead {
    max-width: 680px;
    margin: 0 0 44px;
    color: var(--h-muted);
    font-size: 19px;
    line-height: 1.55;
    text-wrap: pretty;
  }
  .muted {
    color: var(--h-muted);
  }

  /* What it catches */
  /* minmax(0, 1fr): a grid column otherwise refuses to shrink below its
     content's minimum width, which pushed the cards 74 px past a 320 px
     screen (SC 1.4.10 Reflow, Level AA). */
  /* Each numbered group starts at a thin rule across the full width, so its
     label on the left reads as the heading of the cards beside it, and one
     group visibly ends before the next begins. Whitespace alone left the
     labels floating (developer's review, 2026-10-06). A rule, not a band of
     colour or another box: the cards are already boxes, and a box around
     boxes gets heavy. The rule is decoration, so its contrast is not
     required; the group's heading carries the structure (SC 1.3.1 Info and
     Relationships, Level A). */
  .groups {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 48px;
  }
  .group {
    padding-top: 32px;
    border-top: 1px solid var(--h-line);
  }
  .group {
    display: flex;
    flex-wrap: wrap;
    gap: 24px 40px;
    align-items: flex-start;
  }
  .group-intro {
    flex: 1 1 260px;
    max-width: 380px;
  }
  .group-label {
    margin: 0 0 8px;
    color: var(--h-label);
    font-size: 14px;
    font-weight: 700;
  }
  .group-intro h3 {
    margin: 0 0 10px;
    color: var(--h-text);
    font-size: 26px;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }
  .group-intro p:last-child {
    margin: 0;
    color: var(--h-muted);
    font-size: 17px;
    line-height: 1.55;
  }
  .cards {
    flex: 2 1 520px;
    min-width: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: 24px;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    height: 100%;
    padding: 26px;
    border: 1px solid var(--h-card-line);
    border-radius: 12px;
    background: var(--h-card);
  }
  .card h4 {
    margin: 0;
    color: var(--h-text);
    font-size: 20px;
    line-height: 1.25;
  }
  .card > p:not(.proof):not(.card-label) {
    margin: 0;
    color: var(--h-muted);
    font-size: 16px;
    line-height: 1.55;
  }
  .card-label {
    margin: 0;
    color: var(--h-label);
    font-size: 13px;
    font-weight: 700;
  }
  .proof {
    margin: auto 0 0;
    padding-top: 14px;
    border-top: 1px solid var(--h-divider);
    color: var(--h-text);
    font-size: 14px;
  }
  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
  }
  .stats > div {
    display: flex;
    flex-direction: column;
  }
  .n {
    font-size: 24px;
    font-weight: 700;
  }
  .l {
    color: var(--h-muted);
    font-size: 13px;
  }
  .kv {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }
  .kv > span:not(.pill) {
    color: var(--h-muted);
  }
  .kv strong {
    font-weight: 600;
  }
  .pill {
    padding: 7px 12px;
    border-radius: 7px;
    background: var(--h-primary-bg);
    color: var(--h-primary-fg);
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
  }
  .outline-sample {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  /* The flagged element, drawn as the app's Page inspector shows it: a maize
     ring and a navy inner line around the element itself, here the page's
     "Copy link to this heading" button, a 30 by 30 pixel square showing a
     bookmark icon (the page's own icon, so drawn in a page blue, not the
     app's navy). An empty box, and then a wide box with a link icon, were
     tried; both differed from the real screen (developer's review with
     screenshots, 2026-10-06). Decoration inside a picture that already has
     a text description. */
  .target {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    color: #1d5fbf;
    border: 3px solid #f5c400;
    border-radius: 2px;
    outline: 2px solid #0a2647;
    outline-offset: -5px;
    background: #ffffff;
  }
  .target svg {
    width: 14px;
    height: 14px;
  }
  .locator {
    display: block;
    overflow: hidden;
    color: var(--h-text);
    font-family: var(--sl-font-mono);
    font-size: 13px;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* What it can't do */
  .coverage {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: 12px;
  }
  .figure {
    padding: 22px;
    border: 1px solid var(--h-card-line);
    border-radius: 12px;
    background: var(--h-band);
  }
  .figure.plain {
    border: 0;
    background: none;
    padding: 0 0 0 10px;
  }
  .figure p {
    margin: 0;
    color: var(--h-muted);
    font-size: 16px;
    line-height: 1.5;
  }
  .figure .big {
    margin-bottom: 8px;
    color: var(--h-text);
    font-size: 19px;
    font-weight: 700;
  }
  .big span {
    font-size: 40px;
    letter-spacing: -0.02em;
  }
  .figure.plain p {
    margin-bottom: 16px;
  }

  /* Buttons (artifact sizes; at least 44 px tall). */
  .button {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: var(--ax-target);
    border-radius: 8px;
    font: inherit;
    font-size: 18px;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
  }
  .button:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .secondary {
    padding: 15px 24px;
    border: 1px solid var(--h-button-line);
    background: var(--h-band);
    color: var(--h-accent);
  }
  .secondary:hover {
    border-color: var(--h-accent);
  }

  /* Comparison table. Only the table scrolls sideways at 320 px; the page
     never does (SC 1.4.10 Reflow, Level AA, allows it for data tables). The
     scroll area is focusable and named so keyboard users can scroll it. The
     caption names the table for screen readers but is hidden visually,
     because the visible heading just above says the same thing. */
  .table-wrap {
    overflow-x: auto;
    border: 1px solid var(--h-card-line);
    border-radius: 12px;
  }
  table {
    width: 100%;
    min-width: 620px;
    border-collapse: collapse;
    font-size: 17px;
    line-height: 1.45;
    text-align: start;
  }
  th,
  td {
    padding: 18px 22px;
    border-top: 1px solid var(--h-divider);
    text-align: start;
    vertical-align: top;
  }
  thead tr {
    background: var(--h-th);
  }
  thead th {
    padding: 16px 22px;
    border-top: 0;
    color: var(--h-muted);
    font-size: 16px;
  }
  thead th:first-child {
    width: 28%;
  }
  thead th.ours-head {
    background: var(--h-th-ours);
    color: var(--h-accent);
  }
  tbody th {
    color: var(--h-text);
    font-weight: 600;
  }
  td {
    color: var(--h-muted);
  }
  td.ours {
    background: var(--h-td-ours);
    color: var(--h-text);
    font-weight: 500;
  }

  /* Title II */
  .title2 {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: 48px;
    align-items: center;
  }
  .body-lg {
    margin: 0 0 16px;
    color: var(--h-muted);
    font-size: 19px;
    line-height: 1.6;
    text-wrap: pretty;
  }
  .body {
    margin: 0;
    color: var(--h-muted);
    font-size: 17px;
    line-height: 1.6;
    text-wrap: pretty;
  }
  .deadlines {
    overflow: hidden;
    border: 1px solid var(--h-card-line);
    border-radius: 14px;
    background: var(--h-band);
  }
  .deadline {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding: 24px 26px;
  }
  .deadline + .deadline {
    border-top: 1px solid var(--h-divider);
  }
  .deadline p {
    margin: 0;
  }
  .who {
    color: var(--h-muted);
    font-size: 15px;
    font-weight: 600;
  }
  .date {
    margin-top: 4px !important;
    color: var(--h-text);
    font-size: clamp(26px, 3vw, 34px);
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .was {
    margin-top: 4px !important;
    color: var(--h-muted);
    font-size: 14px;
  }
  /* "N days from today" is added by a script; without one the pill is
     empty and hidden, and the date above still says everything. */
  .countdown {
    padding: 5px 12px;
    border-radius: 999px;
    background: var(--h-tint);
    color: var(--h-accent);
    font-size: 15px;
    font-weight: 600;
