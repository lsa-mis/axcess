---
/**
 * Home page.
 *
 * Order follows the questions a visitor asks, in turn (Articulating Design
 * Decisions, 2nd ed.: lead with the outcome people care about, then answer
 * objections): what is it (hero), what does it find that I'm missing
 * (catches), what can't it do (coverage, said plainly and with the real
 * numbers), how is it different (comparison), why now (Title II), the
 * remaining doubts (questions), and what to do next (download or share).
 *
 * Rejected from the v3 draft: a "You can see exactly what was tested"
 * section. Its stage names did not match the app (the app shows Find pages,
 * Check pages, Prepare report, with a percentage) and its last step claimed
 * every page is checked against all of WCAG. The coverage section replaces
 * it with numbers taken from the product's own criterion list.
 *
 * Every number here comes from src/data/coverage.json, exported from
 * src/audit/rules/wcag_coverage.yaml by site/export_data.py, so the page
 * cannot claim coverage the code does not have.
 */
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import Card from "../components/Card.astro";
import LinkButton from "../components/LinkButton.astro";
import SectionHeader from "../components/SectionHeader.astro";
import coverage from "../data/coverage.json";
import { QUESTIONS } from "../data/questions";
import { HONESTY, url } from "../lib/site";

const { covered, total, manualOnly } = coverage.summary;
const homeQuestions = QUESTIONS.filter((q) => ["prove", "cloud", "sign-in", "cost"].includes(q.id));

const rows = [
  {
    k: "Menus, tabs and dialogs",
    a: "Often checked only as the page first loads",
    b: "Opened, and the rule check runs again on what appears",
  },
  {
    k: "Pages behind a sign-in",
    a: "Often skipped or hard to set up",
    b: "You sign in yourself, including Duo, and they are included",
  },
  {
    k: "Getting the report",
    a: "Exported or written up later",
    b: "Ready when the scan finishes, with Excel, Markdown, CSV and JSON exports",
  },
  { k: "Finding the problem", a: "A rule name and a web address", b: "An outline on a saved copy of the page" },
  { k: "Handing off to developers", a: "Find the element yourself", b: "A copyable element locator (CSS selector)" },
  { k: "Where your data goes", a: "Often a vendor's cloud", b: "Stays on your computer" },
  { k: "What it can't check", a: "Often not stated", b: "Listed for every WCAG criterion" },
];
---

<StarlightPage
  frontmatter={{
    title: "Axcess: accessibility testing that runs on your computer",
    description:
      "A free, open-source accessibility scanner that runs on your computer. It opens menus and dialogs, checks the pages behind your sign-in, and keeps every result on your machine.",
    template: "splash",
    tableOfContents: false,
    hero: {
      title: "Test the site your users actually see.",
      tagline:
        "Many scanners only check a page as it first loads. Axcess also opens menus and dialogs, checks the pages behind your sign-in, and has your report ready when the scan finishes.",
    },
  }}
  hasSidebar={true}
>
  <div class="not-content home">
    <section class="band" aria-labelledby="catches">
      <SectionHeader id="catches" label="What it catches" heading="Problems hide where scanners don't look. Axcess looks there." />

      <div class="group">
        <div class="group-intro">
          <p class="group-label">1 · Less risk</p>
          <h3>Find more of what is really there</h3>
          <p>So problems don't first come to light in a complaint.</p>
        </div>
        <div class="cards">
          <Card heading="Opens what your users open" level={4}>
            <p>
              Menus, tabs, accordions and dialogs only appear after a click. Axcess opens them, within set limits,
              and runs the rule check on each page state it reaches. It skips buttons like Sign out, Delete and Buy.
            </p>
            <Fragment slot="proof">
              <dl class="stat-pair">
                <div><dt>Pages</dt><dd>194</dd></div>
                <div><dt>Page states opened by clicking</dt><dd>1,171</dd></div>
              </dl>
              <p class="example-note">From an example scan.</p>
            </Fragment>
          </Card>
          <Card heading="Checks pages behind a sign-in" level={4}>
            <p>
              Student portals, staff tools and course pages usually go untested. Sign in yourself, including U-M
              sign-in and Duo two-step sign-in, and Axcess checks the pages behind it. It deletes the sign-in when
              the scan ends.
            </p>
            <Fragment slot="proof"><p class="kv"><span>Pages behind a sign-in</span><strong>Included</strong></p></Fragment>
          </Card>
        </div>
      </div>

      <div class="group">
        <div class="group-intro">
          <p class="group-label">2 · Less time</p>
          <h3>Fix it without the hunt</h3>
          <p>Designers and developers start with the answer, not a search.</p>
        </div>
        <div class="cards">
          <Card heading="Outlines the exact element" label="For designers" level={4}>
            <p>Each problem is outlined on a saved copy of the page, with its size and its text beside it.</p>
            <Fragment slot="proof">
              <div class="outline-sample">
                <span class="target" aria-hidden="true"></span>
                <span><strong>Size</strong><br />35 pixels wide, 20 pixels tall</span>
              </div>
            </Fragment>
          </Card>
          <Card heading="Points to the code" label="For developers" level={4}>
            <p>Copy the element locator (CSS selector) and paste it into your browser's developer tools.</p>
            <Fragment slot="proof"><code class="locator">.post &gt; .copy-link-btn</code></Fragment>
          </Card>
        </div>
      </div>

      <div class="group">
        <div class="group-intro">
          <p class="group-label">3 · Less friction</p>
          <h3>Move as fast as your team can</h3>
          <p>No waiting for a write-up, and no cloud service to approve.</p>
        </div>
        <div class="cards">
          <Card heading="Report ready when the scan finishes" level={4}>
            <p>
              Every issue comes with its pages, where it is on each page, and how to fix it in plain language.
              Export it as an Excel issue list, a written report, or a CSV or JSON file.
            </p>
            <Fragment slot="proof"><p class="kv"><span>Scan finished</span><strong>12 barriers found</strong></p></Fragment>
          </Card>
          <Card heading="Keeps your data on your computer" level={4}>
            <p>Scans, sign-ins and reports stay on the computer that ran them, which makes IT review easier.</p>
            <Fragment slot="proof"><p class="kv"><span>Where scans run</span><strong>This computer</strong></p></Fragment>
          </Card>
        </div>
      </div>
    </section>

    <section class="band shaded" aria-labelledby="limits">
      <SectionHeader id="limits" label="What it can't do" heading="Honest about what a scan can check.">
        No tool can test all of WCAG. Here is exactly how much Axcess helps with, so you know what a person still
        needs to test.
      </SectionHeader>
      <div class="coverage">
        <div class="coverage-figure">
          <p class="big"><span>{covered}</span> of {total}</p>
          <p>WCAG 2.2 Level A and AA criteria get help from Axcess's checks.</p>
        </div>
        <div class="coverage-figure">
          <p class="big"><span>{manualOnly}</span> of {total}</p>
          <p>need a person to test them. The report gives the steps.</p>
        </div>
        <div class="coverage-more">
          <p>{HONESTY}</p>
          <LinkButton href={url("/coverage/")} variant="secondary">See every criterion</LinkButton>
        </div>
      </div>
    </section>

    <section class="band" aria-labelledby="compare">
      <SectionHeader id="compare" label="Compare" heading="How Axcess differs from many scanners" />
      <div class="table-wrap" role="region" aria-labelledby="compare-caption" tabindex="0">
        <table>
          <caption id="compare-caption" class="sr-only">Axcess compared with many other accessibility scanners</caption>
          <thead>
            <tr>
              <th scope="col">Topic</th>
              <th scope="col">Many other scanners</th>
              <th scope="col">Axcess</th>
            </tr>
          </thead>
          <tbody>
            {
              rows.map((r) => (
                <tr>
                  <th scope="row">{r.k}</th>
                  <td>{r.a}</td>
                  <td class="ours">{r.b}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <section class="band shaded title2" aria-labelledby="title-ii">
      <div>
        <SectionHeader id="title-ii" label="Americans with Disabilities Act (ADA) Title II" heading="You have time to do this well. Start now." />
        <div class="prose">
          <p>
            Public universities and state and local governments must make their web content meet WCAG 2.1 Level
            AA. The Department of Justice moved the deadlines back a year, but the requirements stayed the same.
          </p>
          <p>
            Axcess checks against WCAG 2.1 AA by default, the level Title II requires. Its results are evidence for
            a person to review, not proof that you comply.
          </p>
        </div>
      </div>
      <div class="deadlines">
        <div class="deadline">
          <p class="who">Population of 50,000 or more</p>
          <p class="date"><time datetime="2027-04-26">April 26, 2027</time></p>
          <p class="was">Was April 24, 2026</p>
          <p class="countdown" data-countdown="2027-04-26"></p>
        </div>
        <div class="deadline">
          <p class="who">Population under 50,000, and special district governments</p>
          <p class="date"><time datetime="2028-04-26">April 26, 2028</time></p>
          <p class="was">Was April 26, 2027</p>
        </div>
        <p class="source">
          Source: <a href="https://www.ada.gov/resources/2024-03-08-web-rule/">the Department of Justice's page on the Title II web and mobile app rule (ada.gov)</a>.
        </p>
      </div>
    </section>

    <section class="band" aria-labelledby="questions">
      <SectionHeader id="questions" label="Questions" heading="Common questions" />
      <div class="questions">
        {
          homeQuestions.map((q) => (
            <details>
              <summary>{q.q}</summary>
              <p>{q.a}</p>
            </details>
          ))
        }
      </div>
      <p class="more"><a href={url("/faq/")}>All questions</a></p>
    </section>

    <section class="cta ax-inverse" aria-labelledby="next">
      <div>
        <h2 id="next">See your site the way your users do.</h2>
        <p>
          It's free, and your first scan takes a few minutes to set up. Not the one who decides? Send this page to the
          person who does.
        </p>
      </div>
      <div class="cta-actions">
        <LinkButton href={url("/get-started/#download")} variant="on-inverse">Download Axcess</LinkButton>
        <button type="button" class="share ax-js-only" data-share>Copy link to this page</button>
        <p class="share-status" role="status" data-share-status></p>
      </div>
    </section>
  </div>
</StarlightPage>

<script>
  // Days until the first Title II date. Without scripts the date still shows.
  for (const el of document.querySelectorAll<HTMLElement>("[data-countdown]")) {
    const days = Math.ceil((new Date(`${el.dataset.countdown}T00:00:00`).getTime() - Date.now()) / 86_400_000);
    if (days > 0) el.textContent = `${days.toLocaleString()} days from today`;
  }

  // "Copy link": shown only when scripts run (class ax-js-only). The result is
  // written to a status message, so screen readers hear it (SC 4.1.3 Status
  // Messages, Level AA), and a failed copy says so instead of claiming success.
  const share = document.querySelector<HTMLButtonElement>("[data-share]");
  const status = document.querySelector<HTMLElement>("[data-share-status]");
  share?.addEventListener("click", async () => {
    if (!status) return;
    try {
      await navigator.clipboard.writeText(location.href);
      status.textContent = "Link copied. Paste it into an email or chat.";
    } catch {
      status.textContent = `Copying didn't work. The address is ${location.href}`;
    }
  });
</script>

<style>
  .home {
    --gap: 1.5rem;
  }
  .band {
    padding: 3.5rem 0;
  }
  .band:not(.shaded) + .band:not(.shaded) {
    border-top: 1px solid var(--ax-border);
  }
  /* A rounded panel rather than an edge-to-edge band: the content column's
     edges move with the sidebar, so a full-bleed band left uneven strips. */
  .shaded {
    padding: 3rem clamp(1.25rem, 4vw, 2.5rem);
    border: 1px solid var(--ax-border);
    border-radius: 1rem;
    background: var(--ax-surface-subtle);
  }

  /* Catches */
  .group {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 2.5rem;
    align-items: flex-start;
  }
  .group + .group {
    margin-top: 3rem;
  }
  .group-intro {
    flex: 1 1 15rem;
    max-width: 22rem;
  }
  .group-label {
    margin: 0 0 0.5rem;
    color: var(--ax-fg-subtle);
    font-size: 0.9375rem;
    font-weight: 700;
  }
  .group-intro h3 {
    margin: 0 0 0.5rem;
    color: var(--ax-fg);
    font-size: 1.5rem;
    line-height: 1.2;
  }
  .group-intro p:last-child {
    margin: 0;
    color: var(--ax-fg-muted);
    font-size: 1.0625rem;
    line-height: 1.55;
  }
  .cards {
    flex: 2 1 30rem;
    min-width: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: var(--gap);
  }
  .stat-pair {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin: 0;
  }
  .stat-pair div {
    display: flex;
    flex-direction: column-reverse;
  }
  .stat-pair dt {
    color: var(--ax-fg-subtle);
    font-size: 0.875rem;
  }
  .stat-pair dd {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 700;
  }
  .example-note {
    margin: 0.5rem 0 0;
    color: var(--ax-fg-subtle);
    font-size: 0.875rem;
  }
  .kv {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin: 0;
  }
  .kv span {
    color: var(--ax-fg-subtle);
  }
  .outline-sample {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .target {
    flex-shrink: 0;
    width: 1.625rem;
    height: 2.125rem;
    border: 3px solid var(--ax-maize);
    outline: 2px solid #00274c;
    outline-offset: -5px;
    border-radius: 2px;
    background: var(--ax-surface);
  }
  .locator {
    display: block;
    overflow-wrap: anywhere;
    font-family: var(--sl-font-mono);
    font-size: 0.875rem;
  }

  /* Coverage */
  .coverage {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: var(--gap);
  }
  .coverage-figure {
    padding: 1.5rem;
    border: 1px solid var(--ax-border);
    border-radius: 0.75rem;
    background: var(--ax-surface);
  }
  .coverage-figure p {
    margin: 0;
    color: var(--ax-fg-muted);
    font-size: 1.0625rem;
    line-height: 1.5;
  }
  .coverage-figure .big {
    margin-bottom: 0.5rem;
    color: var(--ax-fg);
    font-size: 1.25rem;
    font-weight: 700;
  }
  .big span {
    font-size: 2.75rem;
    letter-spacing: -0.02em;
  }
  .coverage-more p {
    margin: 0 0 1.25rem;
    color: var(--ax-fg-muted);
    font-size: 1rem;
    line-height: 1.6;
  }

  /* Comparison table. Only the table scrolls sideways at 320 px; the page
     never does (SC 1.4.10 Reflow, Level AA, allows it for data tables). The
     scroll area is focusable and named so keyboard users can scroll it. The
     caption names the table for screen readers but is hidden visually,
     because the visible heading just above says the same thing and a
     caption inside the scroll area was cut off at 320 px. */
  .table-wrap {
    overflow-x: auto;
    border: 1px solid var(--ax-border);
    border-radius: 0.75rem;
  }
  table {
    width: 100%;
    min-width: 38rem;
    border-collapse: collapse;
    font-size: 1.0625rem;
    line-height: 1.45;
    text-align: start;
  }
  th,
  td {
    padding: 1rem 1.25rem;
    border-top: 1px solid var(--ax-border);
    text-align: start;
    vertical-align: top;
  }
  thead th {
    border-top: 0;
    background: var(--ax-surface-muted);
    color: var(--ax-fg);
  }
  tbody th {
    font-weight: 700;
  }
  td {
    color: var(--ax-fg-muted);
  }
  td.ours {
    background: var(--ax-surface-subtle);
    color: var(--ax-fg);
    font-weight: 600;
  }

  /* Title II */
  .title2 {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr));
    gap: 2.5rem;
    align-items: center;
  }
  .prose p {
    margin: 0 0 1rem;
    color: var(--ax-fg-muted);
    font-size: 1.125rem;
    line-height: 1.6;
  }
  .deadlines {
    display: grid;
    gap: 0.75rem;
  }
  .deadline {
    padding: 1.5rem;
    border: 1px solid var(--ax-border);
    border-radius: 0.75rem;
    background: var(--ax-surface);
  }
  .deadline p {
    margin: 0;
  }
  .who {
    color: var(--ax-fg-muted);
    font-weight: 600;
  }
  .date {
    margin-top: 0.25rem !important;
    color: var(--ax-fg);
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .was,
  .countdown,
  .source {
    color: var(--ax-fg-subtle);
    font-size: 0.9375rem;
  }
  .source {
    margin: 0.25rem 0 0;
  }
  .source a {
    color: var(--ax-link);
    text-underline-offset: 0.2em;
  }

  /* Questions: native <details>, which open and close without scripts and
     are announced as expandable (WAI-ARIA APG Disclosure pattern). */
  .questions {
    display: grid;
    gap: 0.75rem;
    max-width: 52rem;
  }
  details {
    border: 1px solid var(--ax-border);
    border-radius: 0.75rem;
    background: var(--ax-surface-subtle);
  }
  summary {
    display: flex;
    align-items: center;
    min-height: var(--ax-target);
    padding: 1rem 1.5rem;
    color: var(--ax-fg);
    font-size: 1.1875rem;
    font-weight: 700;
    cursor: pointer;
  }
  details p {
    margin: 0;
    padding: 0 1.5rem 1.25rem;
    color: var(--ax-fg-muted);
    font-size: 1.0625rem;
    line-height: 1.6;
  }
  .more {
    margin: 1.25rem 0 0;
    font-size: 1.0625rem;
  }
  .more a {
    color: var(--ax-link);
    font-weight: 600;
    text-underline-offset: 0.2em;
  }

  /* Call to action */
  .cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
    margin: 3.5rem 0 1rem;
    padding: clamp(2rem, 5vw, 3.5rem);
    border-radius: 1rem;
    background: var(--ax-inverse-bg);
    color: var(--ax-inverse-fg);
  }
  .cta h2 {
    margin: 0 0 0.75rem;
    color: var(--ax-inverse-fg);
    font-size: clamp(1.75rem, 3.2vw, 2.5rem);
    line-height: 1.15;
  }
  .cta p {
    max-width: 38rem;
    margin: 0;
    color: var(--ax-inverse-fg-subtle);
    font-size: 1.125rem;
    line-height: 1.55;
  }
  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }
  .share {
    min-height: 3.25rem;
    padding: 0.75rem 1.5rem;
    border: 2px solid var(--ax-inverse-fg-subtle);
    border-radius: 0.5rem;
    background: transparent;
    color: var(--ax-inverse-fg);
    font: inherit;
    font-size: 1.125rem;
    font-weight: 700;
    cursor: pointer;
  }
  .share:hover {
    border-color: var(--ax-inverse-fg);
    text-decoration: underline;
  }
  /* Always rendered, even when empty: a live region that appears at the
     moment it changes is often not announced. */
  .share-status {
    flex-basis: 100%;
    font-size: 1rem !important;
  }
</style>
