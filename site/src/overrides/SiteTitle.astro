---
/**
 * The Axcess logo, linking home: the mark and "axcess".
 *
 * The mark is the app's own (components/BrandMark.tsx), drawn inline in
 * currentColor so it follows the theme without two image files. It is
 * decorative: the visible word "axcess" is the link's name, so a screen
 * reader says it once (SC 2.5.3 Label in Name, Level A).
 *
 * The same logo as the app's sidebar (AppShell.tsx), the developer's choice:
 * "axcess" in lowercase Comfortaa Bold, whose round, one-storey "a" matches
 * the mark's inner "a", so mark and word read as one logo. Same proportions
 * too: the app sets a 32px mark beside 20px text with a 6px gap, so here the
 * mark is 1.6 times the text (2rem beside 1.25rem) and the gap 0.3 of it
 * (0.375rem). It is the only lowercase "axcess" and the only Comfortaa on
 * the site: headings and every sentence keep "Axcess", a name with its
 * capital (docs/plain-language.md rule 11), in Atkinson Hyperlegible,
 * because round letters look alike when small. Real text, not a picture of
 * it, so it keeps the theme's colour. No negative letter spacing: that was
 * tuned for Atkinson, and Comfortaa's own spacing is drawn for it.
 *
 * 1.25rem, as in the app, not larger: the name sits beside the page headings
 * and the Download button, and only needs to say where you are.
 */
const { siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title">
  <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true" focusable="false">
    <path d="M 20.31 4.16 A 12.6 12.6 0 1 0 26.45 8.95"></path>
    <path d="M 17.438 21.016 C 16.989 21.141 16.515 21.208 16.026 21.208 C 13.135 21.208 10.792 18.865 10.792 15.974 C 10.792 13.083 13.135 10.74 16.026 10.74 C 18.917 10.74 21.26 13.083 21.26 15.974 C 21.26 17.37 21.26 18.97 21.26 21.016"></path>
    <circle cx="20.31" cy="4.16" r="3.2" fill="currentColor" stroke="none"></circle>
  </svg>
  <span>axcess</span>
</a>

<style>
  .site-title {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: var(--ax-target);
    color: var(--ax-link);
    font-family: "Comfortaa", var(--sl-font);
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.25;
    text-decoration: none;
    white-space: nowrap;
  }
  .site-title span {
    color: var(--ax-fg);
  }
  svg {
    width: 2rem;
    height: 2rem;
    flex-shrink: 0;
  }
</style>
