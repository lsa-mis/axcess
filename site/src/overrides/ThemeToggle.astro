---
/**
 * The day and night switch: one button that turns dark mode on or off.
 *
 * It replaces Starlight's three-way theme menu (Dark, Light, Same as my
 * computer) everywhere, the header and the phone menu, by the developer's
 * choice (2026-10-06): a menu read as a dropdown, not a switch. The cost,
 * told to the developer and accepted: there is no longer a way to go back
 * to "Same as my computer" once you choose. Until the first click the site
 * still follows the computer's setting (and follows it when it changes);
 * after a click it remembers the choice, in the same `starlight-theme`
 * storage Starlight used, so an earlier choice carries over.
 *
 * Built as the WAI-ARIA Authoring Practices toggle button
 * (https://www.w3.org/WAI/ARIA/apg/patterns/button/): a native <button>
 * whose name stays "Dark mode" while aria-pressed says on or off. Changing
 * the name with the state ("Switch to light") was rejected: the APG warns
 * that a label which changes with the state confuses which state is shown.
 * The name is real text, read by screen readers only, not an aria-label
 * (docs/plain-language.md rule 8; WCAG technique C7). The sun and moon are
 * decoration, and the knob sits on the current one, so the state shows by
 * position as well as by icon, not by colour (SC 1.4.1 Use of Color,
 * Level A). The button is 44 px tall and wide (SC 2.5.5 Target Size
 * (Enhanced), Level AAA). Without scripts it cannot work, so theme.css
 * hides it and the page follows the computer's setting.
 */
---

<ax-theme-toggle>
  <button type="button" class="toggle" aria-pressed="false" title="Dark mode">
    <span class="sr-only">Dark mode</span>
    <span class="track" aria-hidden="true">
      <span class="knob"></span>
      <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
      </svg>
      <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"></path>
      </svg>
    </span>
  </button>
</ax-theme-toggle>

{/* Inline, so the switch shows the right state before the page is drawn. */}
<script is:inline>
  document.querySelectorAll("ax-theme-toggle button").forEach((b) =>
    b.setAttribute("aria-pressed", String(document.documentElement.dataset.theme !== "light")),
  );
</script>

<script>
  const KEY = "starlight-theme";
  const root = document.documentElement;
  const isDark = () => root.dataset.theme !== "light";

  function sync(): void {
    document
      .querySelectorAll("ax-theme-toggle button")
      .forEach((b) => b.setAttribute("aria-pressed", String(isDark())));
  }

  function chosen(): boolean {
    try {
      return Boolean(localStorage.getItem(KEY));
    } catch {
      return false;
    }
  }

  // Until someone chooses, follow the computer when its setting changes.
  matchMedia("(prefers-color-scheme: light)").addEventListener("change", (event) => {
    if (chosen()) return;
    root.dataset.theme = event.matches ? "light" : "dark";
    sync();
  });

  class AxThemeToggle extends HTMLElement {
    connectedCallback(): void {
      sync();
      this.querySelector("button")?.addEventListener("click", () => {
        const next = isDark() ? "light" : "dark";
        root.dataset.theme = next;
        try {
          localStorage.setItem(KEY, next);
        } catch {
          // Storage can be blocked; the choice then lasts for this page.
        }
        sync();
      });
    }
  }
  if (!customElements.get("ax-theme-toggle")) customElements.define("ax-theme-toggle", AxThemeToggle);
</script>

<style>
  ax-theme-toggle {
    display: inline-flex;
  }
  .toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: var(--ax-target);
    min-height: var(--ax-target);
    padding: 0 0.25rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--ax-fg);
    cursor: pointer;
  }
  .track {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    width: 3.5rem;
    height: 1.875rem;
    padding: 0 0.375rem;
    border: 1px solid var(--ax-border-strong);
    border-radius: 999px;
    background: var(--sl-color-bg-nav);
  }
  .knob {
    position: absolute;
    top: 2px;
    left: 2px;
    width: calc(1.875rem - 6px);
    height: calc(1.875rem - 6px);
    border-radius: 50%;
    background: var(--ax-inverse-bg);
    transition: transform 160ms ease;
  }
  .toggle[aria-pressed="true"] .knob {
    transform: translateX(calc(3.5rem - 1.875rem));
  }
  svg {
    position: relative;
    width: 1rem;
    height: 1rem;
  }
  /* The icon under the knob takes the knob's text colour, so it stays
     readable on the dark knob in either theme. */
  .toggle[aria-pressed="false"] .sun,
  .toggle[aria-pressed="true"] .moon {
    color: var(--ax-inverse-fg);
  }
  .toggle:hover .track {
    border-color: var(--ax-fg);
  }
  @media (prefers-reduced-motion: reduce) {
    .knob {
      transition: none;
    }
  }
</style>
