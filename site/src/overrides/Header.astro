---
/**
 * Site header: name, search, the four main destinations, GitHub, the day and
 * night switch, and Download.
 *
 * Why these four links: they are the questions a first-time visitor asks
 * (how do I start, how do I use it, what does it check, where does my data
 * go). Everything else is one level down in the sidebar, which lists every
 * page. Download is the one filled button, so there is a single primary
 * action per screen. "Get started" and Download both lead to the Get
 * started page, by the developer's choice (2026-10-06): the link opens the
 * whole path (download, install, first scan), the button jumps straight to
 * the files. Two ways to one page is a cost (COGA: one way to do one
 * thing), accepted because the two answer different needs: "show me how"
 * and "I know, give me the file".
 *
 * Below 72rem the three links are left to the sidebar, which lists them
 * too. Below 50rem the GitHub and theme controls also move into
 * Starlight's menu panel (opened by the menu button, which works without
 * JavaScript because it uses the HTML popover attribute). Showing them in the
 * header as a second row was rejected: a fixed two-row header covers too
 * much of the page at 320 px and at 400% zoom (SC 1.4.10 Reflow, Level AA;
 * SC 2.4.11 Focus Not Obscured (Minimum), Level AA). The order of items is
 * the same on every page (SC 3.2.3 Consistent Navigation, Level AA).
 *
 * The search box gets room to grow (up to 18rem) rather than shrinking to
 * its words: a short box read as a button, not a place to type, and
 * "Search" plus the shortcut barely fit. The GitHub mark is centred in the
 * same 44 px box as the links beside it; Starlight's own box sat it a few
 * pixels high.
 */
// Public component paths, not Starlight's virtual modules, so `astro check`
// can type them. Search and SiteTitle are this site's own overrides.
import SocialIcons from "@astrojs/starlight/components/SocialIcons.astro";
import Search from "./Search.astro";
import ThemeToggle from "./ThemeToggle.astro";
import SiteTitle from "./SiteTitle.astro";
import { MAIN_NAV, url } from "../lib/site";

const path = Astro.url.pathname;
---

<div class="header">
  <div class="title-wrapper">
    <SiteTitle />
  </div>
  <div class="search print:hidden">
    <Search />
  </div>
  <nav aria-label="Main" class="main-nav print:hidden">
    <ul>
      {
        MAIN_NAV.map((item) => (
          <li>
            <a href={url(item.href)} aria-current={path.startsWith(url(item.href)) ? "page" : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <div class="right-group print:hidden">
    <div class="social-icons">
      <SocialIcons />
    </div>
    <ThemeToggle />
    <a class="download" href={url("/get-started/#download")}>Download</a>
  </div>
</div>

<style>
  .header {
    display: flex;
    gap: var(--sl-nav-gap);
    justify-content: space-between;
    align-items: center;
    height: 100%;
  }
  .title-wrapper {
    overflow: clip;
    padding: 0.25rem;
    margin: -0.25rem;
    min-width: 0;
  }
  .search {
    display: flex;
  }
  @media (min-width: 50rem) {
    .search {
      flex: 1 1 auto;
      max-width: 18rem;
      margin-inline-end: auto;
    }
  }
  .main-nav,
  .right-group {
    display: none;
  }
  @media (min-width: 72rem) {
    .header {
      gap: 1.5rem;
    }
    .search {
      flex: 0 1 18rem;
      min-width: 9rem;
      margin-inline-end: auto;
    }
    /* With four links the row is full at 72rem: the search box gives up
       width first, never the name (it was cut to "Axces"). */
    .title-wrapper {
      flex-shrink: 0;
    }
    .main-nav {
      display: block;
    }
    .main-nav ul {
      display: flex;
      gap: 0.25rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }
    .main-nav a {
      display: inline-flex;
      align-items: center;
      min-height: var(--ax-target);
      padding: 0 0.75rem;
      border-radius: 0.5rem;
      color: var(--ax-fg);
      font-weight: 600;
      text-decoration: none;
      white-space: nowrap;
    }
    .main-nav a:hover {
      text-decoration: underline;
      text-underline-offset: 0.2em;
    }
    /* The current section is marked by an underline as well as weight, not
       by colour alone (SC 1.4.1 Use of Color, Level A). */
    .main-nav a[aria-current="page"] {
      text-decoration: underline;
      text-decoration-thickness: 3px;
      text-underline-offset: 0.35em;
    }
  }
  /* From 50rem Starlight shows the sidebar instead of its menu panel, so the
     GitHub link, theme switch and Download move up here. */
  @media (min-width: 50rem) {
    .right-group {
      display: flex;
      gap: 0.5rem;
      align-items: center;
    }
    .social-icons {
      display: flex;
      align-items: center;
    }
    .social-icons :global(a) {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0;
    }
    .social-icons :global(svg) {
      width: 1.375rem;
      height: 1.375rem;
    }
  }
  .download {
    display: inline-flex;
    align-items: center;
    min-height: var(--ax-target);
    padding: 0 1.1rem;
    border-radius: 0.5rem;
    background: var(--ax-inverse-bg);
    color: var(--ax-inverse-fg);
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }
  .download:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
