---
/**
 * The home page hero (only the home page sets `hero` in its frontmatter).
 *
 * Left: what Axcess is and the two next steps. Right: a picture of a report,
 * drawn in HTML rather than a screenshot so it stays sharp, follows the
 * light and dark theme, and can be kept in step with the app's wording.
 * Sizes, spacing, layering and shadows copy the v3 design artifact exactly
 * (see the home page section in theme.css for what differs and why).
 *
 * Choices and why:
 * - One filled button ("Download Axcess"). It goes to the download section
 *   rather than straight to a file: guessing the system can't tell an Intel
 *   Mac from Apple silicon, and only Apple silicon is built, so a direct
 *   file link would hand some readers a file that won't open.
 * - The second button goes to "What Axcess checks", the honest coverage
 *   numbers, because the next question after "what is it" is "what does it
 *   miss" (Articulating Design Decisions: answer the objection early).
 * - The mockup uses a made-up site (www.example.org, reserved by RFC 2606)
 *   and only words the app really shows (Dashboard and Inspector screens).
 *   It is one image to assistive technology, with a text description, so a
 *   screen reader does not read out a fake interface piece by piece
 *   (role="img" with aria-label, WCAG technique ARIA6; SC 1.1.1 Non-text
 *   Content, Level A).
 * - "WCAG" links to its glossary entry, which spells it out (SC 3.1.4
 *   Abbreviations, Level AAA, technique G55). The badge says only "Free and
 *   open source" so it stays one line at 320 px.
 */
import { url } from "../lib/site";

const { hero, title } = Astro.locals.starlightRoute.entry.data;
---

<section class="hero not-content" aria-labelledby="_top">
  <div class="wrap">
    <div class="copy">
      <p class="badge">Free and open source</p>
      <h1 id="_top">{hero?.title ?? title}</h1>
      {hero?.tagline && <p class="tagline">{hero.tagline}</p>}
      <div class="actions">
        <a class="button primary" href={url("/get-started/#download")}>Download Axcess <span aria-hidden="true">↓</span></a>
        <a class="button secondary" href={url("/coverage/")}>See what it checks</a>
      </div>
      <ul class="facts">
        <li>Runs on your own computer</li>
        <li>No account needed</li>
        <li>Mac, Windows and Linux</li>
        <li>Checks <a href={url("/docs/glossary/#wcag")}>WCAG</a> 2.1 AA, or 2.2 if you choose</li>
      </ul>
    </div>

    <div
      class="mockup"
      role="img"
      aria-label="Example of an Axcess report for www.example.org: 194 pages, 1,171 page states opened by clicking, and 12 barriers. In front of it, the saved copy of a page outlines the first of 19 flagged elements, a link, and lists what it is, its text, its size and its element locator."
    >
      <div class="panel summary" aria-hidden="true">
        <p class="meta">Example report</p>
        <p class="site">www.example.org</p>
        <div class="stats">
          <div><span class="n">194</span><span class="l">Pages</span></div>
          <div><span class="n">1,171</span><span class="l">Page states opened by clicking</span></div>
          <div><span class="n">12</span><span class="l">Mostly sure</span></div>
        </div>
      </div>
      <div class="panel inspector" aria-hidden="true">
        <div class="bar">
          <span>Flagged element 1 of 19</span>
          <span class="chips"><span class="chip muted">Previous</span><span class="chip">Next ⌄</span></span>
        </div>
        <dl class="facts-list">
          <dt>What it is</dt><dd>Link</dd>
          <dt>Text or label</dt><dd>“Copy link to this heading”</dd>
          <dt>Size</dt><dd>35 pixels wide, 20 pixels tall</dd>
          <dt>Element locator</dt><dd class="mono">…post &gt; .copy-link-btn.before</dd>
        </dl>
        <div class="saved-copy">
          <p class="page-heading">Using editors to build accessible pages</p>
          <span class="tag">1 of 19</span>
          <div class="row">
            <span class="target"></span>
            <span class="page-sub">Give your post a clear title</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    background: var(--h-page);
  }
  .wrap {
    max-width: 1200px;
    margin: 0 auto;
    padding: 80px 32px 88px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 460px), 1fr));
    gap: 56px;
    align-items: center;
  }
  .badge {
    display: inline-block;
    max-width: 100%;
    margin: 0;
    padding: 6px 14px;
    border-radius: 999px;
    background: var(--h-tint);
    color: var(--h-accent);
    font-size: 14px;
    font-weight: 600;
    white-space: nowrap;
  }
  h1 {
    margin: 22px 0 20px;
    color: var(--h-text);
    font-size: clamp(40px, 5.2vw, 64px);
    font-weight: 700;
    line-height: 1.03;
    letter-spacing: -0.028em;
    text-wrap: balance;
  }
  .tagline {
    max-width: 540px;
    margin: 0 0 32px;
    color: var(--h-muted);
    font-size: 20px;
    line-height: 1.55;
    text-wrap: pretty;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  /* The artifact's two buttons. Links, because both go somewhere. */
  .button {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: var(--ax-target);
    border-radius: 8px;
    font-size: 18px;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }
  .button:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .primary {
    padding: 16px 26px;
    background: var(--h-primary-bg);
    color: var(--h-primary-fg);
  }
  .primary:hover {
    background: var(--h-primary-hover);
  }
  .secondary {
    padding: 15px 24px;
    border: 1px solid var(--h-button-line);
    background: var(--h-band);
    color: var(--h-accent);
  }
  .secondary:hover {
    border-color: var(--h-accent);
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    margin: 26px 0 0;
    padding: 0;
    list-style: none;
    color: var(--h-muted);
    font-size: 15px;
    font-weight: 500;
  }
  .facts a {
    color: var(--h-accent);
    text-underline-offset: 0.2em;
  }

  /* Mockup */
  .mockup {
    position: relative;
    padding: 0 0 0 28px;
  }
  .panel {
    border: 1px solid var(--h-card-line);
    border-radius: 14px;
    background: var(--h-band);
  }
  .summary {
    padding: 20px 22px 64px;
    box-shadow: var(--h-shadow-soft);
  }
  .meta {
    margin: 0;
    color: var(--h-muted);
    font-size: 13px;
    font-weight: 500;
  }
  .site {
    margin: 2px 0 16px;
    color: var(--h-text);
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
  }
  .stats > div {
    display: flex;
    flex-direction: column;
    padding: 10px 12px;
    border-radius: 8px;
    background: var(--h-page);
  }
  .n {
    color: var(--h-text);
    font-size: 20px;
    font-weight: 700;
  }
  .l {
    color: var(--h-muted);
    font-size: 12px;
  }
  .inspector {
    position: relative;
    margin: -44px 0 0 -28px;
    overflow: hidden;
    box-shadow: var(--h-shadow);
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 14px 18px;
    border-bottom: 1px solid var(--h-divider);
    color: var(--h-muted);
    font-size: 14px;
    font-weight: 600;
  }
  .chips {
    display: flex;
    gap: 6px;
  }
  .chip {
    padding: 5px 11px;
    border: 1px solid var(--h-chip-line);
    border-radius: 7px;
    color: var(--h-text);
    font-size: 13px;
    font-weight: 600;
  }
  /* The artifact greys out "Previous" because it is the first element. It
     is part of a picture (role="img"), so its contrast is decoration, but
     it still uses the muted text colour (8:1 or more), not a paler grey. */
  .chip.muted {
    color: var(--h-muted);
  }
  .facts-list {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    gap: 6px 24px;
    margin: 0;
    padding: 14px 18px;
    border-bottom: 1px solid var(--h-divider);
    font-size: 14px;
  }
  dt {
    color: var(--h-muted);
    font-weight: 600;
  }
  dd {
    margin: 0;
    color: var(--h-text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .mono {
    font-family: var(--sl-font-mono);
    font-size: 12.5px;
  }
  /* The saved copy of a page, with the app's maize outline and navy tag. */
  .saved-copy {
    padding: 22px 24px 28px;
    background: var(--h-saved);
  }
  .page-heading {
    margin: 0 0 18px;
    color: var(--h-saved-link);
    font-size: clamp(20px, 2.2vw, 26px);
    font-weight: 700;
    line-height: 1.15;
  }
  .tag {
    display: inline-block;
    padding: 3px 9px;
    border: 3px solid #f5c400;
    border-radius: 6px 6px 0 0;
    background: #0a2647;
    color: #ffffff;
    font-size: 13px;
    font-weight: 700;
  }
  .row {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .target {
    flex-shrink: 0;
    width: 36px;
    height: 46px;
    border: 4px solid #f5c400;
    border-radius: 2px;
    outline: 3px solid #0a2647;
    outline-offset: -7px;
    background: #ffffff;
  }
  .page-sub {
    color: var(--h-saved-link);
    font-size: clamp(18px, 2vw, 24px);
    font-weight: 700;
  }
  @media (max-width: 30rem) {
    .wrap {
      padding: 56px 20px 64px;
    }
    .mockup {
      padding-inline-start: 0;
    }
    .inspector {
      margin: -44px 0 0;
    }
    .facts-list {
      grid-template-columns: minmax(0, 1fr);
      gap: 2px;
    }
    dd + dt {
      margin-top: 8px;
    }
  }
</style>
